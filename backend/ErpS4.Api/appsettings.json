{
  "ConnectionStrings": {
    "ErpS4": "Server=localhost;Database=ErpS4;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "https://erps4.local",
    "Audience": "erps4-api",
    "SigningKey": "replace-this-with-a-key-from-the-secret-store-at-least-32-bytes"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
