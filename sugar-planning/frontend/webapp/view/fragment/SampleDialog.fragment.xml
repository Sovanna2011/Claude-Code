<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">

	<Dialog id="sampleDialog" title="{i18n>qualitySampleTitle}" contentWidth="28rem">
		<content>
			<f:SimpleForm editable="true" layout="ResponsiveGridLayout"
				labelSpanM="4" columnsM="1" class="sapUiNoMarginTop">
				<f:content>
					<Label text="{i18n>fieldProduct}" required="true"/>
					<Select forceSelection="false" selectedKey="{view>/sample/productId}" width="100%"
						items="{path: 'view>/products', sorter: {path: 'code'}}">
						<core:Item key="{view>id}" text="{view>code} — {view>name}"/>
					</Select>

					<Label text="{i18n>fieldBusinessDate}" required="true"/>
					<DatePicker value="{view>/sample/businessDate}" valueFormat="yyyy-MM-dd"
						displayFormat="yyyy-MM-dd" width="100%"/>

					<Label text="{i18n>fieldComment}"/>
					<TextArea value="{view>/sample/comment}" rows="2" width="100%"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button text="{i18n>create}" type="Emphasized" press=".onSubmitSample"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>cancel}" press=".onCancelSample"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
