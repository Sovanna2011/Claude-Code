# Copy to .env and edit. Nothing here has a usable default for production.

# --- environment -----------------------------------------------------------
# development | test | uat | production
# In production the application refuses to start with AUTH_MODE=dev,
# STORE=memory or SEED_DEMO=true.
APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=info
LOG_FORMAT=json

# --- database --------------------------------------------------------------
POSTGRES_DB=sugarplan
POSTGRES_USER=sugarplan
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_PORT=5432
DB_MAX_CONNS=20

# --- http ------------------------------------------------------------------
HTTP_PORT=8080
# Leave empty for a same-origin deployment, which is the normal case.
HTTP_ALLOWED_ORIGINS=

# --- authentication --------------------------------------------------------
# dev: local accounts, development only.
# oidc: the enterprise identity provider.
AUTH_MODE=dev
AUTH_DEV_SECRET=local-development-secret-change-me

# For AUTH_MODE=oidc:
AUTH_ISSUER=
AUTH_AUDIENCE=
# Where the provider puts roles. Keycloak: realm_access.roles
AUTH_ROLES_CLAIM=roles
# Map provider groups onto application roles:
#   AUTH_ROLE_MAPPING=sugar-planners=PRODUCTION_PLANNER,sugar-approvers=APPROVER
AUTH_ROLE_MAPPING=

# --- demonstration data ----------------------------------------------------
# Loads the Kampong Speu 2026-2027 scenario. Refused when APP_ENV=production.
SEED_DEMO=true
SEED_ACTUAL_DAYS=14

# --- factory ---------------------------------------------------------------
FACTORY_TIMEZONE=Asia/Phnom_Penh
