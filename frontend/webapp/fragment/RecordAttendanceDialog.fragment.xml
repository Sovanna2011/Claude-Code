<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">

    <Dialog id="attDialog" title="{i18n>recordAttendanceTitle}" contentWidth="30rem" draggable="true">
        <content>
            <MessageStrip text="{i18n>attendanceHint}" type="Information" showIcon="true" class="sapUiSmallMargin"/>
            <f:SimpleForm layout="ResponsiveGridLayout" editable="true"
                labelSpanXL="5" labelSpanL="5" labelSpanM="5" columnsXL="1" columnsL="1">
                <f:content>
                    <Label text="{i18n>fldAbsenceType}" required="true"/>
                    <Select selectedKey="{att>/attendanceType}" items="{att>/attendanceTypes}">
                        <core:Item key="{att>key}" text="{att>key} - {att>text}"/>
                    </Select>

                    <Label text="{i18n>fldValidFrom}" required="true"/>
                    <DatePicker value="{att>/begda}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>

                    <Label text="{i18n>fldValidTo}" required="true"/>
                    <DatePicker value="{att>/endda}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>

                    <Label text="{i18n>colHours}"/>
                    <Input value="{att>/hours}" type="Number"/>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton><Button type="Emphasized" text="{i18n>btnSubmit}" press=".onAttConfirm"/></beginButton>
        <endButton><Button text="{i18n>btnCancel}" press=".onAttCancel"/></endButton>
    </Dialog>
</core:FragmentDefinition>
