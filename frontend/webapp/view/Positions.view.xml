<mvc:View
    controllerName="hr.module.controller.Positions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    height="100%">

    <Page id="positionsPage" title="{i18n>positionsTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://org-chart" text="{i18n>navOrg}" press=".onNavOrg"/>
            <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </headerContent>
        <subHeader>
            <OverflowToolbar>
                <Label text="{i18n>filterOrgUnit}"/>
                <Select selectedKey="{view>/orgFilter}" change=".onOrgFilterChange" forceSelection="false"
                    items="{view>/orgUnits}" width="20rem">
                    <core:Item xmlns:core="sap.ui.core" key="{view>orgUnitId}" text="{view>orgUnitName}"/>
                </Select>
                <ToolbarSpacer/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table id="positionsTable" items="{/positions}" growing="true">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>positionsTitle}" level="H2"/>
                        <ToolbarSpacer/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="8rem"><Text text="{i18n>colPositionId}"/></Column>
                    <Column><Text text="{i18n>colPositionName}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colOrgUnit}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colJob}"/></Column>
                    <Column><Text text="{i18n>colHolder}"/></Column>
                    <Column width="8rem" hAlign="End"><Text text="{i18n>colOccupancy}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{positionId}"/>
                            <Text text="{positionName}"/>
                            <Text text="{orgUnitName}"/>
                            <Text text="{jobName}"/>
                            <Text text="{holderName}"/>
                            <ObjectStatus
                                text="{path: 'isVacant', formatter: '.formatter.vacantText'}"
                                state="{path: 'isVacant', formatter: '.formatter.vacantState'}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
