<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Dialog id="rejectDialog" title="{i18n>rejectDialogTitle}" contentWidth="28rem" draggable="true">
        <content>
            <VBox class="sapUiContentPadding">
                <Text text="{i18n>rejectDialogInfo}"/>
                <Label text="{i18n>rejectReason}" required="true" class="sapUiSmallMarginTop"/>
                <TextArea value="{reject>/note}" rows="4" width="100%"
                    placeholder="{i18n>rejectReasonPh}" maxLength="250"/>
            </VBox>
        </content>
        <beginButton>
            <Button type="Reject" text="{i18n>btnReject}" press=".onRejectConfirm"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press=".onRejectCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
