{
  "ConnectionStrings": {
    "POApproval": "Server=localhost;Database=POApproval;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "//": "CHANGE SigningKey before any non-local use; keep it secret (env var / user-secrets).",
    "SigningKey": "dev-only-change-me-po-approval-signing-key-2026",
    "TokenLifetimeMinutes": 480
  },
  "Sap": {
    "//": "UseLocalMirror=true reads/writes the SQL replica of the SAP tables. Set false and register an RFC ISapEccConnector (SAP .NET Connector / NCo 3) to talk to a live ECC 6.0 EHP8 system.",
    "UseLocalMirror": true,
    "Rfc": {
      "AppServerHost": "sapecc.example.com",
      "SystemNumber": "00",
      "Client": "800",
      "User": "RFC_PO",
      "Language": "EN"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8080", "http://localhost:8081" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
