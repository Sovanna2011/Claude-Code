@page "/projections/{Id:int}"
@attribute [Authorize]
@inject PlanningApi Api
@inject NavigationManager Navigation

<PageTitle>Projection @(projection?.ProjectionNo ?? "")</PageTitle>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />
<SuccessToast Message="@success" OnDismiss="() => success = null" />

@if (projection is null)
{
    <LoadingPanel Message="Loading the projection…" />
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">
                @projection.ProjectionNo
                <span class="text-secondary fs-6">version @projection.Version</span>
                <StatusBadge Projection="projection.Status" />
                @if (projection.IsReadOnly)
                {
                    <span class="badge text-bg-light border">read-only</span>
                }
            </h1>
            <small class="text-secondary">
                @projection.EstateName · @projection.SeasonName ·
                @projection.PlanningStartDate.ToString("yyyy-MM-dd") → @projection.PlanningEndDate.ToString("yyyy-MM-dd")
            </small>
        </div>

        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm" href="projections">Back to list</a>
            <a class="btn btn-outline-secondary btn-sm" href="activity-plan?projectionId=@projection.Id">Activity plan</a>
            <a class="btn btn-outline-secondary btn-sm" href="capacity?projectionId=@projection.Id">Capacity</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <KpiCard Title="Projected area" Value="@projection.TotalProjectedAreaHa.ToString("N2")" Unit="ha" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Expected production" Value="@projection.TotalExpectedProductionTons.ToString("N2")" Unit="t" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Lines" Value="@projection.Lines.Count.ToString()" Caption="one per block" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Prepared by" Value="@(projection.PreparedBy ?? "—")"
                     Caption="@(projection.ApprovedBy is null ? "not approved yet" : $"approved by {projection.ApprovedBy}")" />
        </div>
    </div>

    @* ---------------------------------------------------------------- workflow *@
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Workflow</div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @foreach (var action in AvailableActions())
                {
                    <button class="btn btn-sm @ActionClass(action)" @onclick="() => RunWorkflow(action)" disabled="@busy">
                        @ActionLabel(action)
                    </button>
                }
                @if (projection.Status == ProjectionStatus.Approved && projection.IsCurrentVersion)
                {
                    <button class="btn btn-outline-warning btn-sm" @onclick="() => revising = true" disabled="@busy">Revise</button>
                }
                <input class="form-control form-control-sm ms-auto" style="max-width:360px"
                       placeholder="Comment (required to reject)" @bind="workflowComment" />
            </div>

            @if (revising)
            {
                <div class="border rounded p-3 mt-3 bg-light">
                    <label class="form-label">Revision reason</label>
                    <textarea class="form-control mb-2" rows="2" @bind="revisionReason"></textarea>
                    <div class="d-flex gap-2">
                        <button class="btn btn-warning btn-sm" @onclick="Revise" disabled="@busy">Create revision</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => revising = false">Cancel</button>
                    </div>
                    <div class="small text-secondary mt-2">
                        The approved version is copied, kept read-only, and a new version number is issued.
                    </div>
                </div>
            }

            @if (projection.ApprovalHistory.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>When</th>
                                <th>Action</th>
                                <th>From → to</th>
                                <th>By</th>
                                <th>Comments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in projection.ApprovalHistory)
                            {
                                <tr>
                                    <td class="small">@entry.ActionAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@entry.Action</td>
                                    <td class="small">@entry.FromStatus → @entry.ToStatus</td>
                                    <td>@entry.ActionBy</td>
                                    <td class="small">@entry.Comments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ------------------------------------------------------------------- lines *@
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Projection lines</span>
            @if (IsEditable)
            {
                <button class="btn btn-success btn-sm" @onclick="StartAddLine">Add line</button>
            }
        </div>
        <div class="card-body">
            @if (editingLine is not null)
            {
                <EditForm Model="editingLine" OnValidSubmit="SaveLine" class="border rounded p-3 mb-3 bg-light">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Block</label>
                            <InputSelect class="form-select" @bind-Value="editingLine.BlockId">
                                @foreach (var block in blocks)
                                {
                                    <option value="@block.Id">@block.Display (@block.Value?.ToString("N2") ha plantable)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Variety</label>
                            <InputSelect class="form-select" @bind-Value="editingLine.CaneVarietyId">
                                @foreach (var variety in varieties)
                                {
                                    <option value="@variety.Id">@variety.Display</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Crop type</label>
                            <InputSelect class="form-select" @bind-Value="editingLine.CropType">
                                <option value="@CropType.NewPlanting">New planting</option>
                                <option value="@CropType.Ratoon">Ratoon</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-2"><label class="form-label">Priority</label><InputNumber class="form-control" @bind-Value="editingLine.Priority" /></div>

                        <div class="col-md-3"><label class="form-label">Projected area (ha)</label><InputNumber class="form-control" @bind-Value="editingLine.ProjectedPlantingAreaHa" step="0.01" /></div>
                        <div class="col-md-3"><label class="form-label">Planting start</label><InputDate class="form-control" @bind-Value="editingLine.PlannedPlantingStart" /></div>
                        <div class="col-md-3"><label class="form-label">Planting end</label><InputDate class="form-control" @bind-Value="editingLine.PlannedPlantingEnd" /></div>
                        <div class="col-md-3"><label class="form-label">Yield (t/ha)</label><InputNumber class="form-control" @bind-Value="editingLine.ExpectedYieldPerHa" step="0.1" /></div>

                        <div class="col-md-3"><label class="form-label">Loss (%)</label><InputNumber class="form-control" @bind-Value="editingLine.ExpectedLossPercent" step="0.1" /></div>
                        <div class="col-md-9"><label class="form-label">Remarks</label><InputText class="form-control" @bind-Value="editingLine.Remarks" /></div>
                    </div>

                    <div class="alert alert-secondary py-2 px-3 mt-2 mb-0 small">
                        Harvestable area = @HarvestablePreview().ToString("N2") ha ·
                        expected production = @ProductionPreview().ToString("N2") t
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-success btn-sm" type="submit" disabled="@busy">
                            @(editingLineId is null ? "Add line" : "Save line")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => editingLine = null">Cancel</button>
                    </div>
                </EditForm>
            }

            @if (projection.Lines.Count == 0)
            {
                <div class="text-secondary small">No lines yet. Add one block per line.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Farm</th>
                                <th>Zone</th>
                                <th>Block</th>
                                <th>Crop</th>
                                <th>Variety</th>
                                <th class="text-end">Available (ha)</th>
                                <th class="text-end">Projected (ha)</th>
                                <th>Planting window</th>
                                <th>Harvest</th>
                                <th class="text-end">Yield</th>
                                <th class="text-end">Loss %</th>
                                <th class="text-end">Harvestable</th>
                                <th class="text-end">Production (t)</th>
                                <th class="text-end">Prio</th>
                                @if (IsEditable)
                                {
                                    <th class="text-end">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in projection.Lines)
                            {
                                <tr>
                                    <td>@line.FarmName</td>
                                    <td>@line.ZoneName</td>
                                    <td>@line.BlockCode</td>
                                    <td>@line.CropType</td>
                                    <td>@line.VarietyName</td>
                                    <td class="text-end">@line.AvailableAreaHa.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@line.ProjectedPlantingAreaHa.ToString("N2")</td>
                                    <td class="small">@line.PlannedPlantingStart.ToString("MM-dd") → @line.PlannedPlantingEnd.ToString("MM-dd")</td>
                                    <td class="small">@(line.ExpectedHarvestDate?.ToString("yyyy-MM"))</td>
                                    <td class="text-end">@line.ExpectedYieldPerHa.ToString("N1")</td>
                                    <td class="text-end">@line.ExpectedLossPercent.ToString("N1")</td>
                                    <td class="text-end">@line.HarvestableAreaHa.ToString("N2")</td>
                                    <td class="text-end">@line.ExpectedCaneProductionTons.ToString("N2")</td>
                                    <td class="text-end">@line.Priority</td>
                                    @if (IsEditable)
                                    {
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary" @onclick="() => StartEditLine(line)">Edit</button>
                                                <button class="btn btn-outline-danger" @onclick="() => RemoveLine(line.Id)">Remove</button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="6">Total</td>
                                <td class="text-end">@projection.TotalProjectedAreaHa.ToString("N2")</td>
                                <td colspan="5"></td>
                                <td class="text-end">@projection.TotalExpectedProductionTons.ToString("N2")</td>
                                <td colspan="@(IsEditable ? 2 : 1)"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProjectionDetailDto? projection;
    private IReadOnlyList<LookupDto> blocks = Array.Empty<LookupDto>();
    private IReadOnlyList<LookupDto> varieties = Array.Empty<LookupDto>();
    private ProjectionLineUpsertDto? editingLine;
    private int? editingLineId;
    private string? workflowComment;
    private string? revisionReason;
    private bool revising;
    private string? error;
    private string? errorCode;
    private string? success;
    private bool busy;

    private bool IsEditable => projection is not null && !projection.IsReadOnly
        && projection.Status is ProjectionStatus.Draft or ProjectionStatus.Rejected or ProjectionStatus.Revised;

    protected override async Task OnParametersSetAsync()
    {
        blocks = await Api.LookupAsync("blocks");
        varieties = await Api.LookupAsync("varieties");
        await Load();
    }

    private async Task Load()
    {
        try
        {
            busy = true;
            error = null;
            projection = await Api.GetProjectionAsync(Id);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    // ------------------------------------------------------------------- lines

    private void StartAddLine()
    {
        editingLineId = null;
        editingLine = new ProjectionLineUpsertDto
        {
            BlockId = blocks.FirstOrDefault()?.Id ?? 0,
            CaneVarietyId = varieties.FirstOrDefault()?.Id ?? 0,
            PlannedPlantingStart = projection?.PlanningStartDate ?? DateOnly.FromDateTime(DateTime.Today),
            PlannedPlantingEnd = (projection?.PlanningStartDate ?? DateOnly.FromDateTime(DateTime.Today)).AddDays(14),
            Priority = 5
        };
    }

    private void StartEditLine(ProjectionLineDto line)
    {
        editingLineId = line.Id;
        editingLine = new ProjectionLineUpsertDto
        {
            Id = line.Id,
            BlockId = line.BlockId,
            CropType = line.CropType,
            CaneVarietyId = line.CaneVarietyId,
            ProjectedPlantingAreaHa = line.ProjectedPlantingAreaHa,
            PlannedPlantingStart = line.PlannedPlantingStart,
            PlannedPlantingEnd = line.PlannedPlantingEnd,
            ExpectedYieldPerHa = line.ExpectedYieldPerHa,
            ExpectedLossPercent = line.ExpectedLossPercent,
            Priority = line.Priority,
            Remarks = line.Remarks
        };
    }

    private decimal HarvestablePreview()
        => editingLine is null ? 0m
            : Math.Round(editingLine.ProjectedPlantingAreaHa * (1m - editingLine.ExpectedLossPercent / 100m), 2);

    private decimal ProductionPreview()
        => editingLine is null ? 0m : Math.Round(HarvestablePreview() * editingLine.ExpectedYieldPerHa, 2);

    private async Task SaveLine()
    {
        if (editingLine is null) return;
        try
        {
            busy = true;
            error = null;
            if (editingLineId is null) await Api.AddLineAsync(Id, editingLine);
            else await Api.UpdateLineAsync(Id, editingLineId.Value, editingLine);
            success = "Line saved.";
            editingLine = null;
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveLine(int lineId)
    {
        try
        {
            busy = true;
            await Api.RemoveLineAsync(Id, lineId);
            success = "Line removed.";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- workflow

    private IEnumerable<ApprovalAction> AvailableActions()
    {
        if (projection is null || projection.IsReadOnly) yield break;
        switch (projection.Status)
        {
            case ProjectionStatus.Draft:
            case ProjectionStatus.Revised:
            case ProjectionStatus.Rejected:
                yield return ApprovalAction.Submit;
                break;
            case ProjectionStatus.Submitted:
                yield return ApprovalAction.Review;
                yield return ApprovalAction.Approve;
                yield return ApprovalAction.Reject;
                yield return ApprovalAction.ReturnForCorrection;
                break;
            case ProjectionStatus.UnderReview:
                yield return ApprovalAction.Approve;
                yield return ApprovalAction.Reject;
                yield return ApprovalAction.ReturnForCorrection;
                break;
            case ProjectionStatus.Approved:
                yield return ApprovalAction.Close;
                break;
        }
    }

    private static string ActionLabel(ApprovalAction action) => action switch
    {
        ApprovalAction.ReturnForCorrection => "Return for correction",
        _ => action.ToString()
    };

    private static string ActionClass(ApprovalAction action) => action switch
    {
        ApprovalAction.Approve => "btn-success",
        ApprovalAction.Reject => "btn-danger",
        ApprovalAction.ReturnForCorrection => "btn-outline-warning",
        ApprovalAction.Close => "btn-outline-dark",
        _ => "btn-primary"
    };

    private async Task RunWorkflow(ApprovalAction action)
    {
        try
        {
            busy = true;
            error = null;
            projection = await Api.WorkflowAsync(Id, new WorkflowActionDto
            {
                Action = action,
                Comments = workflowComment,
                RowVersion = projection?.RowVersion
            });
            success = $"{ActionLabel(action)} completed.";
            workflowComment = null;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Revise()
    {
        if (string.IsNullOrWhiteSpace(revisionReason))
        {
            error = "Enter the reason for the revision.";
            errorCode = "REASON_REQUIRED";
            return;
        }

        try
        {
            busy = true;
            error = null;
            var revision = await Api.ReviseAsync(Id, new ReviseProjectionDto { RevisionReason = revisionReason! });
            revising = false;
            revisionReason = null;
            if (revision is not null) Navigation.NavigateTo($"projections/{revision.Id}");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }
}
