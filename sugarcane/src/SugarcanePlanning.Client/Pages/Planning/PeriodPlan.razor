@page "/period-plan"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Monthly & weekly plan</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Monthly and weekly planting plan</h1>
        <small class="text-secondary">Planting targets per period, versus what has actually been completed.</small>
    </div>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width:auto" @onchange="OnSeasonChanged" aria-label="Season">
            <option value="">Current open season</option>
            @foreach (var season in seasons)
            {
                <option value="@season.Id">@season.Display</option>
            }
        </select>
        <div class="btn-group btn-group-sm">
            <button class="btn @(monthly ? "btn-success" : "btn-outline-secondary")" @onclick="() => monthly = true">Monthly</button>
            <button class="btn @(!monthly ? "btn-success" : "btn-outline-secondary")" @onclick="() => monthly = false">Weekly</button>
        </div>
    </div>
</div>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

@if (busy && data is null)
{
    <LoadingPanel />
}
else if (data is null || Periods.Count == 0)
{
    <div class="alert alert-secondary">
        No period targets yet — generate the activity plan for an approved projection first.
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <KpiCard Title="Total target" Value="@Periods.Sum(p => p.TargetAreaHa).ToString("N0")" Unit="ha" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Completed" Value="@Periods.Sum(p => p.ActualAreaHa).ToString("N0")" Unit="ha"
                     ProgressPercent="@(Periods.Sum(p => p.TargetAreaHa) <= 0 ? 0 : Periods.Sum(p => p.ActualAreaHa) / Periods.Sum(p => p.TargetAreaHa) * 100m)" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Peak period"
                     Value="@(Periods.OrderByDescending(p => p.TargetAreaHa).First().Label)"
                     Caption="@($"{Periods.Max(p => p.TargetAreaHa):N0} ha")" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Periods" Value="@Periods.Count.ToString()" Caption="@(monthly ? "months" : "ISO weeks")" />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">@(monthly ? "Monthly" : "Weekly") planting targets</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Period</th>
                            <th>From</th>
                            <th>To</th>
                            <th class="text-end">Target (ha)</th>
                            <th class="text-end">Actual (ha)</th>
                            <th class="text-end">Variance (ha)</th>
                            <th style="min-width:180px">Completion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var period in Periods)
                        {
                            <tr>
                                <td class="fw-semibold">@period.Label</td>
                                <td class="small">@period.PeriodStart.ToString("yyyy-MM-dd")</td>
                                <td class="small">@period.PeriodEnd.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">@period.TargetAreaHa.ToString("N2")</td>
                                <td class="text-end">@period.ActualAreaHa.ToString("N2")</td>
                                <td class="text-end @((period.ActualAreaHa - period.TargetAreaHa) < 0 ? "text-danger" : "text-success")">
                                    @((period.ActualAreaHa - period.TargetAreaHa).ToString("N2"))
                                </td>
                                <td><ProgressBarCell Percent="period.CompletionPercent" /></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td colspan="3">Total</td>
                            <td class="text-end">@Periods.Sum(p => p.TargetAreaHa).ToString("N2")</td>
                            <td class="text-end">@Periods.Sum(p => p.ActualAreaHa).ToString("N2")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-white fw-semibold">Area by farm, zone and block</div>
        <div class="card-body">
            <ul class="nav nav-pills mb-3">
                @foreach (var level in new[] { "Farm", "Zone", "Block" })
                {
                    <li class="nav-item">
                        <button class="nav-link @(breakdown == level ? "active" : "")" @onclick="() => breakdown = level">@level</button>
                    </li>
                }
            </ul>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@breakdown</th>
                            <th class="text-end">Planned (ha)</th>
                            <th class="text-end">New planting (ha)</th>
                            <th class="text-end">Ratoon (ha)</th>
                            <th class="text-end">Actual (ha)</th>
                            <th style="min-width:180px">Completion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in CurrentBreakdown)
                        {
                            <tr>
                                <td>@row.Name</td>
                                <td class="text-end">@row.PlannedAreaHa.ToString("N2")</td>
                                <td class="text-end">@row.NewPlantingAreaHa.ToString("N2")</td>
                                <td class="text-end">@row.RatoonAreaHa.ToString("N2")</td>
                                <td class="text-end">@row.ActualAreaHa.ToString("N2")</td>
                                <td><ProgressBarCell Percent="row.CompletionPercent" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private DashboardDto? data;
    private IReadOnlyList<LookupDto> seasons = Array.Empty<LookupDto>();
    private int? seasonId;
    private bool monthly = true;
    private string breakdown = "Farm";
    private string? error;
    private string? errorCode;
    private bool busy;

    private List<PeriodTargetDto> Periods => (monthly ? data?.MonthlyTargets : data?.WeeklyTargets) ?? new List<PeriodTargetDto>();

    private List<AreaBreakdownDto> CurrentBreakdown => breakdown switch
    {
        "Zone" => data?.AreaByZone ?? new List<AreaBreakdownDto>(),
        "Block" => data?.AreaByBlock ?? new List<AreaBreakdownDto>(),
        _ => data?.AreaByFarm ?? new List<AreaBreakdownDto>()
    };

    protected override async Task OnInitializedAsync()
    {
        seasons = await Api.LookupAsync("seasons");
        await Load();
    }

    private async Task Load()
    {
        try
        {
            busy = true;
            error = null;
            data = await Api.GetDashboardAsync(seasonId);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnSeasonChanged(ChangeEventArgs args)
    {
        seasonId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await Load();
    }
}
