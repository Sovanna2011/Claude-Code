@page "/material-requirements"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Material requirements</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Material requirement planning</h1>
        <small class="text-secondary">
            Net available = stock + incoming − reserved · shortage = max(requirement − net available, 0)
        </small>
    </div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="Recalculate"
            disabled="@(query.ProjectionId is null || busy)">
        Recalculate from plan
    </button>
</div>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />
<SuccessToast Message="@success" OnDismiss="() => success = null" />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Projection</label>
                <select class="form-select form-select-sm" @onchange="OnProjectionChanged">
                    <option value="">All projections</option>
                    @foreach (var projection in projections)
                    {
                        <option value="@projection.Id">@projection.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Category</label>
                <select class="form-select form-select-sm" @onchange="OnCategoryChanged">
                    <option value="">All categories</option>
                    @foreach (var category in Enum.GetValues<MaterialCategory>())
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Farm</label>
                <select class="form-select form-select-sm" @onchange="OnFarmChanged">
                    <option value="">All farms</option>
                    @foreach (var farm in farms)
                    {
                        <option value="@farm.Id">@farm.Display</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Group by</label>
                <select class="form-select form-select-sm" @onchange="OnGroupChanged">
                    @foreach (var option in GroupOptions)
                    {
                        <option value="@option" selected="@(option == query.GroupBy)">@option</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="shortagesOnly"
                           checked="@query.ShortagesOnly" @onchange="OnShortagesChanged" />
                    <label class="form-check-label small" for="shortagesOnly">Shortages only</label>
                </div>
            </div>
            <div class="col-md-1 text-end">
                <button class="btn btn-success btn-sm" @onclick="Load" disabled="@busy">Apply</button>
            </div>
        </div>
    </div>
</div>

@if (busy && rows.Count == 0)
{
    <LoadingPanel Message="Consolidating requirements…" />
}
else if (rows.Count == 0)
{
    <div class="alert alert-secondary">
        No requirements found. Generate the activity plan for a projection first — requirements
        follow from the plan.
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <KpiCard Title="Materials planned" Value="@rows.Count.ToString()" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="With shortage" Value="@rows.Count(r => r.ShortageQuantity > 0).ToString()"
                     ValueClass="@(rows.Any(r => r.ShortageQuantity > 0) ? "text-danger" : "")" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Earliest delivery"
                     Value="@(rows.Where(r => r.RequiredDeliveryDate is not null).Select(r => r.RequiredDeliveryDate!.Value).DefaultIfEmpty().Min().ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Planned area covered" Value="@rows.Max(r => r.PlannedAreaHa).ToString("N0")" Unit="ha" />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">Requirement versus availability</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Material</th>
                            <th>Category</th>
                            @if (query.GroupBy == "activity")
                            {
                                <th>Activity</th>
                            }
                            @if (query.GroupBy == "block")
                            {
                                <th>Block</th>
                            }
                            @if (query.GroupBy == "farm")
                            {
                                <th>Farm</th>
                            }
                            @if (query.GroupBy == "month")
                            {
                                <th>Period</th>
                            }
                            @if (query.GroupBy == "variety")
                            {
                                <th>Variety</th>
                            }
                            <th class="text-end">Area (ha)</th>
                            <th class="text-end">Base</th>
                            <th class="text-end">Waste</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Stock</th>
                            <th class="text-end">Reserved</th>
                            <th class="text-end">Incoming</th>
                            <th class="text-end">Net available</th>
                            <th class="text-end">Shortage</th>
                            <th class="text-end">Surplus</th>
                            <th>Delivery by</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr class="@(row.ShortageQuantity > 0 ? "table-warning" : "")">
                                <td>@row.MaterialCode — @row.MaterialName</td>
                                <td>@row.Category</td>
                                @if (query.GroupBy == "activity")
                                {
                                    <td>@row.ActivityName</td>
                                }
                                @if (query.GroupBy == "block")
                                {
                                    <td>@row.BlockName</td>
                                }
                                @if (query.GroupBy == "farm")
                                {
                                    <td>@row.FarmName</td>
                                }
                                @if (query.GroupBy == "month")
                                {
                                    <td>@row.PlanningYear-@row.PlanningMonth?.ToString("D2")</td>
                                }
                                @if (query.GroupBy == "variety")
                                {
                                    <td>@row.VarietyName</td>
                                }
                                <td class="text-end">@row.PlannedAreaHa.ToString("N2")</td>
                                <td class="text-end">@row.BaseRequirement.ToString("N2")</td>
                                <td class="text-end">@row.WasteQuantity.ToString("N2")</td>
                                <td class="text-end fw-semibold">@row.TotalRequirement.ToString("N2") @row.Unit</td>
                                <td class="text-end">@row.AvailableStock.ToString("N2")</td>
                                <td class="text-end">@row.ReservedQuantity.ToString("N2")</td>
                                <td class="text-end">@row.IncomingQuantity.ToString("N2")</td>
                                <td class="text-end">@row.NetAvailableQuantity.ToString("N2")</td>
                                <td class="text-end @(row.ShortageQuantity > 0 ? "text-danger fw-semibold" : "")">@row.ShortageQuantity.ToString("N2")</td>
                                <td class="text-end">@row.SurplusQuantity.ToString("N2")</td>
                                <td class="small">@(row.RequiredDeliveryDate?.ToString("yyyy-MM-dd"))</td>
                                <td><StatusBadge Capacity="row.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] GroupOptions = { "material", "activity", "block", "farm", "month", "variety" };

    private readonly MaterialRequirementQuery query = new() { GroupBy = "material" };
    private IReadOnlyList<MaterialRequirementDto> rows = Array.Empty<MaterialRequirementDto>();
    private IReadOnlyList<LookupDto> projections = Array.Empty<LookupDto>();
    private IReadOnlyList<LookupDto> farms = Array.Empty<LookupDto>();
    private string? error;
    private string? errorCode;
    private string? success;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        projections = await Api.LookupAsync("projections");
        farms = await Api.LookupAsync("farms");
        await Load();
    }

    private async Task Load()
    {
        try
        {
            busy = true;
            error = null;
            rows = await Api.GetMaterialRequirementsAsync(query);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Recalculate()
    {
        if (query.ProjectionId is null) return;
        try
        {
            busy = true;
            error = null;
            await Api.RecalculateRequirementsAsync(query.ProjectionId.Value);
            success = "Requirements recalculated from the current activity plan.";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private void OnProjectionChanged(ChangeEventArgs args)
        => query.ProjectionId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;

    private void OnCategoryChanged(ChangeEventArgs args)
        => query.Category = Enum.TryParse<MaterialCategory>(args.Value?.ToString(), out var category) ? category : null;

    private void OnFarmChanged(ChangeEventArgs args)
        => query.FarmId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;

    private void OnGroupChanged(ChangeEventArgs args)
        => query.GroupBy = args.Value?.ToString() ?? "material";

    private void OnShortagesChanged(ChangeEventArgs args)
        => query.ShortagesOnly = args.Value is bool value && value;
}
