@page "/fuel-labor"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Fuel & labor projection</PageTitle>

<h1 class="h4 mb-1">Fuel and labor projection</h1>
<p class="text-secondary small">
    Fuel by area = area × L/ha · fuel by hour = hours × L/h · required workers =
    ceil(labor-days ÷ working days). Procurement uses the larger of the two fuel figures.
</p>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Projection</label>
                <select class="form-select form-select-sm" @onchange="OnProjectionChanged">
                    <option value="">All projections</option>
                    @foreach (var projection in projections)
                    {
                        <option value="@projection.Id">@projection.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Farm</label>
                <select class="form-select form-select-sm" @onchange="OnFarmChanged">
                    <option value="">All farms</option>
                    @foreach (var farm in farms)
                    {
                        <option value="@farm.Id">@farm.Display</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Group by</label>
                <select class="form-select form-select-sm" @onchange="OnGroupChanged">
                    @foreach (var option in GroupOptions)
                    {
                        <option value="@option" selected="@(option == query.GroupBy)">@option</option>
                    }
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button class="btn btn-success btn-sm" @onclick="Load" disabled="@busy">Apply</button>
            </div>
        </div>
    </div>
</div>

@if (busy && fuel.Count == 0 && labor.Count == 0)
{
    <LoadingPanel />
}
else
{
    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">
                    Fuel projection
                    <span class="float-end text-secondary small">
                        total @fuel.Sum(f => f.ProjectedFuelLiters).ToString("N0") L
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (fuel.Count == 0)
                    {
                        <div class="p-3 text-secondary small">No fuel requirement for this selection.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@query.GroupBy</th>
                                        <th class="text-end">Area (ha)</th>
                                        <th class="text-end">Hours</th>
                                        <th class="text-end">By area (L)</th>
                                        <th class="text-end">By hour (L)</th>
                                        <th class="text-end">Projected (L)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in fuel)
                                    {
                                        <tr>
                                            <td>@row.GroupName</td>
                                            <td class="text-end">@row.PlannedAreaHa.ToString("N2")</td>
                                            <td class="text-end">@row.PlannedWorkingHours.ToString("N1")</td>
                                            <td class="text-end">@row.FuelByAreaLiters.ToString("N0")</td>
                                            <td class="text-end">@row.FuelByHourLiters.ToString("N0")</td>
                                            <td class="text-end fw-semibold">@row.ProjectedFuelLiters.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">
                    Labor projection
                    <span class="float-end text-secondary small">
                        peak @(labor.Count == 0 ? 0 : labor.Max(l => l.RequiredWorkers)) workers
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (labor.Count == 0)
                    {
                        <div class="p-3 text-secondary small">No labor requirement for this selection.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@query.GroupBy</th>
                                        <th class="text-end">Area (ha)</th>
                                        <th class="text-end">Labor-days</th>
                                        <th class="text-end">Working days</th>
                                        <th class="text-end">Required</th>
                                        <th class="text-end">Available</th>
                                        <th class="text-end">Gap</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in labor)
                                    {
                                        <tr>
                                            <td>@row.GroupName</td>
                                            <td class="text-end">@row.PlannedAreaHa.ToString("N2")</td>
                                            <td class="text-end">@row.RequiredLaborDays.ToString("N1")</td>
                                            <td class="text-end">@row.WorkingDays</td>
                                            <td class="text-end fw-semibold">@row.RequiredWorkers</td>
                                            <td class="text-end">@row.AvailableWorkers</td>
                                            <td class="text-end @(row.WorkerGap < 0 ? "text-danger fw-semibold" : "")">@row.WorkerGap</td>
                                            <td><StatusBadge Capacity="row.Status" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] GroupOptions = { "activity", "farm", "day", "week", "month", "tractor" };

    private readonly FuelLaborQuery query = new() { GroupBy = "activity" };
    private IReadOnlyList<FuelProjectionDto> fuel = Array.Empty<FuelProjectionDto>();
    private IReadOnlyList<LaborProjectionDto> labor = Array.Empty<LaborProjectionDto>();
    private IReadOnlyList<LookupDto> projections = Array.Empty<LookupDto>();
    private IReadOnlyList<LookupDto> farms = Array.Empty<LookupDto>();
    private string? error;
    private string? errorCode;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        projections = await Api.LookupAsync("projections");
        farms = await Api.LookupAsync("farms");
        await Load();
    }

    private async Task Load()
    {
        try
        {
            busy = true;
            error = null;
            fuel = await Api.GetFuelProjectionAsync(query);
            // "tractor" is a fuel-only grouping; the labor view falls back to activity.
            var laborQuery = new FuelLaborQuery
            {
                ProjectionId = query.ProjectionId,
                FarmId = query.FarmId,
                GroupBy = query.GroupBy == "tractor" ? "activity" : query.GroupBy
            };
            labor = await Api.GetLaborProjectionAsync(laborQuery);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private void OnProjectionChanged(ChangeEventArgs args)
        => query.ProjectionId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;

    private void OnFarmChanged(ChangeEventArgs args)
        => query.FarmId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;

    private void OnGroupChanged(ChangeEventArgs args)
        => query.GroupBy = args.Value?.ToString() ?? "activity";
}
