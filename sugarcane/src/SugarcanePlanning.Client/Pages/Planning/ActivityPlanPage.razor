@page "/activity-plan"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Activity plan & Gantt</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Activity planning</h1>
        <small class="text-secondary">
            Generated from an approved projection: sequence, day offset and blocking dependencies decide every date.
        </small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <select class="form-select form-select-sm" style="width:auto" @onchange="OnProjectionChanged" aria-label="Projection">
            <option value="">Select a projection…</option>
            @foreach (var item in projections)
            {
                <option value="@item.Id" selected="@(item.Id == ProjectionId)">@item.Code (@item.Name)</option>
            }
        </select>
        <button class="btn btn-success btn-sm" @onclick="Generate" disabled="@(ProjectionId is null || busy)">
            Generate activity plan
        </button>
    </div>
</div>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />
<SuccessToast Message="@success" OnDismiss="() => success = null" />

@if (warnings.Count > 0)
{
    <div class="alert alert-warning">
        <strong>Generated with warnings</strong>
        <ul class="mb-0 small">
            @foreach (var warning in warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@if (ProjectionId is null)
{
    <div class="alert alert-secondary">Select a projection to see its activity plan.</div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(tab == "gantt" ? "active" : "")" @onclick='() => tab = "gantt"'>Gantt</button></li>
        <li class="nav-item"><button class="nav-link @(tab == "list" ? "active" : "")" @onclick='() => tab = "list"'>List</button></li>
        <li class="nav-item"><button class="nav-link @(tab == "calendar" ? "active" : "")" @onclick='() => tab = "calendar"'>Calendar</button></li>
    </ul>

    @if (busy && plans is null)
    {
        <LoadingPanel Message="Loading activity plans…" />
    }
    else if (tab == "gantt")
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Timeline</span>
                <select class="form-select form-select-sm" style="width:auto" @onchange="OnFarmChanged" aria-label="Farm filter">
                    <option value="">All farms</option>
                    @foreach (var farm in farms)
                    {
                        <option value="@farm.Id">@farm.Display</option>
                    }
                </select>
            </div>
            <div class="card-body">
                <GanttChart View="gantt" />
            </div>
        </div>
    }
    else if (tab == "list")
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Activity plans</div>
            <div class="card-body">
                @if (editing is not null)
                {
                    <EditForm Model="editing" OnValidSubmit="SavePlan" class="border rounded p-3 mb-3 bg-light">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-3"><label class="form-label">Planned start</label><InputDate class="form-control" @bind-Value="editing.PlannedStartDate" /></div>
                            <div class="col-md-3"><label class="form-label">Planned end</label><InputDate class="form-control" @bind-Value="editing.PlannedEndDate" /></div>
                            <div class="col-md-2"><label class="form-label">Area (ha)</label><InputNumber class="form-control" @bind-Value="editing.PlannedAreaHa" step="0.01" /></div>
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <InputSelect class="form-select" @bind-Value="editing.Status">
                                    @foreach (var status in Enum.GetValues<ActivityStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2"><label class="form-label">Supervisor</label><InputText class="form-control" @bind-Value="editing.SupervisorName" /></div>
                            <div class="col-12"><label class="form-label">Remarks</label><InputText class="form-control" @bind-Value="editing.Remarks" /></div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-success btn-sm" type="submit" disabled="@busy">Save</button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => editing = null">Cancel</button>
                        </div>
                    </EditForm>
                }

                @if (plans is null || plans.Items.Count == 0)
                {
                    <div class="text-secondary small">No activity plans yet. Use “Generate activity plan”.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Block</th>
                                    <th class="text-end">Seq</th>
                                    <th>Activity</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th class="text-end">Days</th>
                                    <th class="text-end">Area (ha)</th>
                                    <th class="text-end">Daily target</th>
                                    <th class="text-end">Tractors</th>
                                    <th class="text-end">Workers</th>
                                    <th class="text-end">Fuel (L)</th>
                                    <th>Status</th>
                                    <th style="min-width:130px">Completion</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var plan in plans.Items)
                                {
                                    <tr>
                                        <td class="small">@plan.BlockName</td>
                                        <td class="text-end">@plan.SequenceNo</td>
                                        <td>@plan.ActivityName</td>
                                        <td class="small">@plan.PlannedStartDate.ToString("yyyy-MM-dd")</td>
                                        <td class="small">@plan.PlannedEndDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">@plan.WorkingDays</td>
                                        <td class="text-end">@plan.PlannedAreaHa.ToString("N2")</td>
                                        <td class="text-end">@plan.DailyTargetHa.ToString("N2")</td>
                                        <td class="text-end">@plan.RequiredTractorCount</td>
                                        <td class="text-end">@plan.RequiredWorkers</td>
                                        <td class="text-end">@plan.PlannedFuelLiters.ToString("N0")</td>
                                        <td><StatusBadge Activity="plan.Status" /></td>
                                        <td><ProgressBarCell Percent="plan.CompletionPercent" /></td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary" @onclick="() => StartEdit(plan)">Edit</button>
                                                <a class="btn btn-outline-secondary" href="projection-vs-actual?planId=@plan.Id">Actuals</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <Pager TItem="ActivityPlanDto" Result="plans" OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
                }
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Activity calendar</div>
            <div class="card-body">
                @if (gantt is null || gantt.Bars.Count == 0)
                {
                    <div class="text-secondary small">No activity plans to place on the calendar.</div>
                }
                else
                {
                    <div class="calendar-grid">
                        @for (var day = gantt.RangeStart; day <= gantt.RangeEnd; day = day.AddDays(1))
                        {
                            var current = day;
                            var active = gantt.Bars.Where(b => b.Start <= current && current <= b.End).ToList();
                            <div class="calendar-day @(current.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "is-weekend" : "")">
                                <div class="day-number small">@current.ToString("MMM d")</div>
                                @if (active.Count == 0)
                                {
                                    <div class="text-secondary small">—</div>
                                }
                                else
                                {
                                    @foreach (var item in active.Take(4))
                                    {
                                        <div class="small text-truncate" title="@item.BlockName — @item.ActivityName">
                                            <span class="badge text-bg-light border">@item.ActivityName</span>
                                        </div>
                                    }
                                    @if (active.Count > 4)
                                    {
                                        <div class="small text-secondary">+@(active.Count - 4) more</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public int? ProjectionId { get; set; }

    private string tab = "gantt";
    private readonly QueryParameters query = new() { PageSize = 50 };
    private IReadOnlyList<LookupDto> projections = Array.Empty<LookupDto>();
    private IReadOnlyList<LookupDto> farms = Array.Empty<LookupDto>();
    private PagedResult<ActivityPlanDto>? plans;
    private GanttViewDto? gantt;
    private ActivityPlanUpdateDto? editing;
    private int? editingId;
    private int? farmFilter;
    private List<string> warnings = new();
    private string? error;
    private string? errorCode;
    private string? success;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        projections = await Api.LookupAsync("projections");
        farms = await Api.LookupAsync("farms");
        if (ProjectionId is not null) await Load();
    }

    private async Task OnProjectionChanged(ChangeEventArgs args)
    {
        ProjectionId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        warnings.Clear();
        if (ProjectionId is not null) await Load();
    }

    private async Task OnFarmChanged(ChangeEventArgs args)
    {
        farmFilter = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await Load();
    }

    private async Task Load()
    {
        if (ProjectionId is null) return;
        try
        {
            busy = true;
            error = null;
            plans = await Api.GetActivityPlansAsync(ProjectionId, null, null, query);
            gantt = await Api.GetGanttAsync(ProjectionId.Value, farmFilter);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Generate()
    {
        if (ProjectionId is null) return;
        try
        {
            busy = true;
            error = null;
            var result = await Api.GenerateActivityPlansAsync(new GenerateActivityPlanRequest
            {
                ProjectionId = ProjectionId.Value,
                Regenerate = true
            });
            warnings = result?.Warnings ?? new List<string>();
            success = result is null
                ? "Activity plan generated."
                : $"{result.PlansCreated} activity plans created ({result.PlansRemoved} replaced), " +
                  $"{result.EarliestStart:yyyy-MM-dd} → {result.LatestEnd:yyyy-MM-dd}.";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartEdit(ActivityPlanDto plan)
    {
        editingId = plan.Id;
        editing = new ActivityPlanUpdateDto
        {
            PlannedStartDate = plan.PlannedStartDate,
            PlannedEndDate = plan.PlannedEndDate,
            PlannedAreaHa = plan.PlannedAreaHa,
            SupervisorName = plan.SupervisorName,
            Status = plan.Status,
            Remarks = plan.Remarks,
            RowVersion = plan.RowVersion
        };
    }

    private async Task SavePlan()
    {
        if (editing is null || editingId is null) return;
        try
        {
            busy = true;
            error = null;
            await Api.UpdateActivityPlanAsync(editingId.Value, editing);
            success = "Activity plan updated.";
            editing = null;
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.IsConcurrencyConflict
                ? "Another user changed this plan. Reload and try again."
                : ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task GoToPage(int page)
    {
        query.Page = page;
        await Load();
    }

    private async Task ChangePageSize(int size)
    {
        query.PageSize = size;
        query.Page = 1;
        await Load();
    }
}
