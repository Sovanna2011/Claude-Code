@page "/seasons"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Growing seasons</PageTitle>

<h1 class="h4 mb-3">Growing seasons</h1>
<p class="text-secondary small">
    A season fixes the planting and harvesting windows. Projection lines must fall inside the
    planting window, and a closed season no longer accepts changes.
</p>

<CrudTable TItem="GrowingSeasonDto" TUpsert="GrowingSeasonUpsertDto"
           Title="Seasons"
           Columns="@(new[] { "Code", "Name", "Season", "Planting window", "Harvest window", "Projections", "Status" })"
           RowTemplate="RenderRow"
           EditorTemplate="RenderEditor"
           ToEditModel="ToEditModel"
           NewModel="NewModel"
           OnLoad="@(q => Api.GetSeasonsAsync(q))"
           OnCreate="@(dto => Api.CreateSeasonAsync(dto))"
           OnUpdate="@((id, dto) => Api.UpdateSeasonAsync(id, dto))"
           OnDelete="@(id => Api.DeleteSeasonAsync(id))"
           IdSelector="@(s => s.Id)" />

@code {
    private IReadOnlyList<LookupDto> companies = Array.Empty<LookupDto>();

    protected override async Task OnInitializedAsync() => companies = await Api.LookupAsync("companies");

    private GrowingSeasonUpsertDto NewModel()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return new GrowingSeasonUpsertDto
        {
            CompanyId = companies.FirstOrDefault()?.Id ?? 0,
            StartDate = new DateOnly(today.Year, 1, 1),
            EndDate = new DateOnly(today.Year + 1, 12, 31),
            PlannedPlantingStart = new DateOnly(today.Year, 3, 1),
            PlannedPlantingEnd = new DateOnly(today.Year, 8, 31),
            ExpectedHarvestStart = new DateOnly(today.Year + 1, 5, 1),
            ExpectedHarvestEnd = new DateOnly(today.Year + 1, 11, 30)
        };
    }

    private GrowingSeasonUpsertDto ToEditModel(GrowingSeasonDto s) => new()
    {
        CompanyId = s.CompanyId,
        Code = s.Code,
        Name = s.Name,
        StartDate = s.StartDate,
        EndDate = s.EndDate,
        PlannedPlantingStart = s.PlannedPlantingStart,
        PlannedPlantingEnd = s.PlannedPlantingEnd,
        ExpectedHarvestStart = s.ExpectedHarvestStart,
        ExpectedHarvestEnd = s.ExpectedHarvestEnd,
        Status = s.Status,
        Remarks = s.Remarks,
        RowVersion = s.RowVersion
    };

    private RenderFragment<GrowingSeasonDto> RenderRow => season =>
    @<text>
        <td>@season.Code</td>
        <td>@season.Name</td>
        <td class="small">@season.StartDate.ToString("yyyy-MM-dd") → @season.EndDate.ToString("yyyy-MM-dd")</td>
        <td class="small">@season.PlannedPlantingStart.ToString("yyyy-MM-dd") → @season.PlannedPlantingEnd.ToString("yyyy-MM-dd")</td>
        <td class="small">@season.ExpectedHarvestStart.ToString("yyyy-MM-dd") → @season.ExpectedHarvestEnd.ToString("yyyy-MM-dd")</td>
        <td class="text-end">@season.ProjectionCount</td>
        <td><StatusBadge Season="season.Status" /></td>
    </text>;

    private RenderFragment<GrowingSeasonUpsertDto> RenderEditor => model =>
    @<text>
        <div class="col-md-4">
            <label class="form-label">Company</label>
            <InputSelect class="form-select" @bind-Value="model.CompanyId">
                @foreach (var company in companies)
                {
                    <option value="@company.Id">@company.Display</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2"><label class="form-label">Code</label><InputText class="form-control" @bind-Value="model.Code" /></div>
        <div class="col-md-6"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="model.Name" /></div>

        <div class="col-md-3"><label class="form-label">Season start</label><InputDate class="form-control" @bind-Value="model.StartDate" /></div>
        <div class="col-md-3"><label class="form-label">Season end</label><InputDate class="form-control" @bind-Value="model.EndDate" /></div>
        <div class="col-md-3"><label class="form-label">Planting start</label><InputDate class="form-control" @bind-Value="model.PlannedPlantingStart" /></div>
        <div class="col-md-3"><label class="form-label">Planting end</label><InputDate class="form-control" @bind-Value="model.PlannedPlantingEnd" /></div>
        <div class="col-md-3"><label class="form-label">Harvest start</label><InputDate class="form-control" @bind-Value="model.ExpectedHarvestStart" /></div>
        <div class="col-md-3"><label class="form-label">Harvest end</label><InputDate class="form-control" @bind-Value="model.ExpectedHarvestEnd" /></div>

        <div class="col-md-3">
            <label class="form-label">Status</label>
            <InputSelect class="form-select" @bind-Value="model.Status">
                @foreach (var status in Enum.GetValues<SeasonStatus>())
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </div>
        <div class="col-12"><label class="form-label">Remarks</label><InputTextArea class="form-control" rows="2" @bind-Value="model.Remarks" /></div>
    </text>;
}
