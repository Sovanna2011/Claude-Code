@page "/varieties"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Sugarcane varieties</PageTitle>

<h1 class="h4 mb-3">Sugarcane varieties</h1>
<p class="text-secondary small">
    The seed rate drives the seed-cane requirement, and the yield and loss percentage are the
    defaults copied onto every new projection line.
</p>

<CrudTable TItem="CaneVarietyDto" TUpsert="CaneVarietyUpsertDto"
           Title="Varieties"
           Columns="@(new[] { "Code", "Name", "Soil", "Seed rate (t/ha)", "Period (months)", "Yield (t/ha)", "Loss %", "Planting window", "Active" })"
           RowTemplate="RenderRow"
           EditorTemplate="RenderEditor"
           ToEditModel="ToEditModel"
           NewModel="@(() => new CaneVarietyUpsertDto { CompanyId = companies.FirstOrDefault()?.Id ?? 0 })"
           OnLoad="@(q => Api.GetVarietiesAsync(q))"
           OnCreate="@(dto => Api.CreateVarietyAsync(dto))"
           OnUpdate="@((id, dto) => Api.UpdateVarietyAsync(id, dto))"
           OnDelete="@(id => Api.DeleteVarietyAsync(id))"
           IdSelector="@(v => v.Id)" />

@code {
    private static readonly string[] MonthNames =
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };

    private IReadOnlyList<LookupDto> companies = Array.Empty<LookupDto>();

    protected override async Task OnInitializedAsync() => companies = await Api.LookupAsync("companies");

    private CaneVarietyUpsertDto ToEditModel(CaneVarietyDto v) => new()
    {
        CompanyId = v.CompanyId,
        Code = v.Code,
        Name = v.Name,
        RecommendedSoilType = v.RecommendedSoilType,
        SeedRatePerHa = v.SeedRatePerHa,
        GrowingPeriodMonths = v.GrowingPeriodMonths,
        ExpectedYieldPerHa = v.ExpectedYieldPerHa,
        ExpectedLossPercent = v.ExpectedLossPercent,
        RecommendedPlantingStartMonth = v.RecommendedPlantingStartMonth,
        RecommendedPlantingEndMonth = v.RecommendedPlantingEndMonth,
        IsActive = v.IsActive,
        RowVersion = v.RowVersion
    };

    private RenderFragment<CaneVarietyDto> RenderRow => variety =>
    @<text>
        <td>@variety.Code</td>
        <td>@variety.Name</td>
        <td>@variety.RecommendedSoilType</td>
        <td class="text-end">@variety.SeedRatePerHa.ToString("N2")</td>
        <td class="text-end">@variety.GrowingPeriodMonths</td>
        <td class="text-end">@variety.ExpectedYieldPerHa.ToString("N1")</td>
        <td class="text-end">@variety.ExpectedLossPercent.ToString("N1")</td>
        <td class="small">@MonthNames[variety.RecommendedPlantingStartMonth - 1] – @MonthNames[variety.RecommendedPlantingEndMonth - 1]</td>
        <td>@(variety.IsActive ? "Yes" : "No")</td>
    </text>;

    private RenderFragment<CaneVarietyUpsertDto> RenderEditor => model =>
    @<text>
        <div class="col-md-3">
            <label class="form-label">Company</label>
            <InputSelect class="form-select" @bind-Value="model.CompanyId">
                @foreach (var company in companies)
                {
                    <option value="@company.Id">@company.Display</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2"><label class="form-label">Code</label><InputText class="form-control" @bind-Value="model.Code" /></div>
        <div class="col-md-4"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="model.Name" /></div>
        <div class="col-md-3">
            <label class="form-label">Recommended soil</label>
            <InputSelect class="form-select" @bind-Value="model.RecommendedSoilType">
                @foreach (var soil in Enum.GetValues<SoilType>())
                {
                    <option value="@soil">@soil</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-3"><label class="form-label">Seed rate (t/ha)</label><InputNumber class="form-control" @bind-Value="model.SeedRatePerHa" step="0.1" /></div>
        <div class="col-md-3"><label class="form-label">Growing period (months)</label><InputNumber class="form-control" @bind-Value="model.GrowingPeriodMonths" /></div>
        <div class="col-md-3"><label class="form-label">Expected yield (t/ha)</label><InputNumber class="form-control" @bind-Value="model.ExpectedYieldPerHa" step="0.1" /></div>
        <div class="col-md-3"><label class="form-label">Expected loss (%)</label><InputNumber class="form-control" @bind-Value="model.ExpectedLossPercent" step="0.1" /></div>

        <div class="col-md-3">
            <label class="form-label">Planting from</label>
            <InputSelect class="form-select" @bind-Value="model.RecommendedPlantingStartMonth">
                @for (var month = 1; month <= 12; month++)
                {
                    var m = month;
                    <option value="@m">@MonthNames[m - 1]</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-3">
            <label class="form-label">Planting to</label>
            <InputSelect class="form-select" @bind-Value="model.RecommendedPlantingEndMonth">
                @for (var month = 1; month <= 12; month++)
                {
                    var m = month;
                    <option value="@m">@MonthNames[m - 1]</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="varietyActive" />
                <label class="form-check-label" for="varietyActive">Active</label>
            </div>
        </div>
    </text>;
}
