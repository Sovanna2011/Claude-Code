@*
    Where the blocks actually are.

    The screen prefers a real Google map and needs a key in wwwroot/appsettings.json under
    "GoogleMaps:ApiKey" to draw one. Without a key — or when the key is rejected, or the browser
    cannot reach maps.googleapis.com — it draws the same blocks from their stored coordinates and
    says so. Deployments on an estate network with no route to Google still get a usable screen,
    and "Open in Google Maps" works from either mode because it is only a link.
*@
@page "/block-map"
@attribute [Authorize]
@implements IAsyncDisposable
@inject PlanningApi Api
@inject IJSRuntime Js
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>Block locations</PageTitle>

<h1 class="h4 mb-1">Block locations</h1>
<p class="text-secondary small">
    Every block with coordinates, coloured by how far its activity programme has got and sized by
    plantable area. Coordinates are maintained on the <a href="blocks">Plantation blocks</a> screen.
</p>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

@if (loading)
{
    <LoadingPanel Message="Loading blocks…" />
}
else if (located.Count == 0)
{
    <div class="alert alert-secondary">
        No block has a latitude and longitude yet. Add them on the
        <a href="blocks">Plantation blocks</a> screen and they will appear here.
    </div>
}
else
{
    @if (mode == MapMode.Fallback)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-start">
            <div>
                <strong>Showing the built-in plot.</strong>
                @fallbackReason
                Set <code>GoogleMaps:ApiKey</code> in <code>wwwroot/appsettings.json</code> for a
                satellite map; the plot below uses the same coordinates either way.
            </div>
            <button class="btn btn-sm btn-outline-secondary ms-3" @onclick="RetryGoogleMap">Retry</button>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <a class="btn btn-sm btn-outline-success" target="_blank" rel="noopener"
           href="@BlockMapProjection.GoogleMapsLink(centreLatitude, centreLongitude)">Open estate in Google Maps</a>
        @if (skipped > 0)
        {
            <span class="badge text-bg-warning">@skipped block(s) without coordinates</span>
        }
        <span class="text-secondary small ms-auto">
            @located.Count block(s) plotted · @located.Sum(b => b.PlantableAreaHa).ToString("N0") ha plantable
        </span>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-2">
                    @* Kept in the document in both modes: the interop needs a live element to
                       render into, and hiding it with CSS keeps its size for fitBounds. *@
                    <div id="@MapElementId" class="rounded border"
                         style="height:32rem;@(mode == MapMode.Fallback ? "display:none" : "")"></div>

                    @if (mode == MapMode.Starting)
                    {
                        <LoadingPanel Message="Starting the map…" />
                    }

                    @if (mode == MapMode.Fallback)
                    {
                        <svg viewBox="0 0 @Fmt(plot.Width) @Fmt(plot.Height)" role="img"
                             aria-label="Plot of plantation block locations"
                             style="width:100%;height:32rem;background:#f5f7f8;border-radius:.375rem">
                            @foreach (var farm in FarmLabels())
                            {
                                @* The group is not decoration: Razor reads a bare <text> at the
                                   start of a block as its own escape tag and refuses attributes on it. *@
                                <g pointer-events="none">
                                    <text x="@Fmt(farm.X)" y="@Fmt(farm.Y)" text-anchor="middle" font-size="16"
                                          font-weight="700" fill="#546e7a" stroke="#f5f7f8" stroke-width="4"
                                          paint-order="stroke">@farm.Name</text>
                                </g>
                            }
                            @foreach (var marker in Markers())
                            {
                                <g role="button" tabindex="0" aria-label="@marker.Block.Code"
                                   style="cursor:pointer" @onclick="() => Select(marker.Block.Id)"
                                   @onkeydown="e => OnMarkerKey(e, marker.Block.Id)">
                                    <title>@marker.Tooltip</title>
                                    <circle cx="@Fmt(marker.X)" cy="@Fmt(marker.Y)" r="@Fmt(marker.Radius)"
                                            fill="@marker.Colour" fill-opacity="0.85" stroke="#ffffff"
                                            stroke-width="@(marker.Block.Id == selectedId ? 3 : 1.5)" />
                                    <circle cx="@Fmt(marker.X)" cy="@Fmt(marker.Y)" r="@Fmt(marker.Radius + 10)"
                                            fill="none" pointer-events="all" />
                                    <text x="@Fmt(marker.X)" y="@Fmt(marker.Y + marker.Radius + 13)"
                                          text-anchor="middle" font-size="12" fill="#546e7a"
                                          stroke="#f5f7f8" stroke-width="3" paint-order="stroke"
                                          pointer-events="none">@marker.Block.Code</text>
                                </g>
                            }
                        </svg>
                    }

                    <div class="d-flex flex-wrap gap-3 small text-secondary mt-2 px-1">
                        @foreach (var band in Bands)
                        {
                            <span>
                                <span class="d-inline-block rounded-circle me-1"
                                      style="width:.6rem;height:.6rem;background:@band.Colour"></span>@band.Label
                            </span>
                        }
                        <span>· circle size = plantable area</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">
                    @(Selected is null ? "Block detail" : Selected.Code)
                </div>
                <div class="card-body">
                    @if (Selected is null)
                    {
                        <p class="text-secondary small mb-0">Choose a block on the map, or from the list below.</p>
                    }
                    else
                    {
                        var progress = Progress(Selected.Id);
                        <dl class="row small mb-3">
                            <dt class="col-5">Name</dt><dd class="col-7">@Selected.Name</dd>
                            <dt class="col-5">Farm / zone</dt><dd class="col-7">@Selected.FarmName · @Selected.ZoneName</dd>
                            <dt class="col-5">Plantable</dt>
                            <dd class="col-7">@Selected.PlantableAreaHa.ToString("N2") ha of @Selected.TotalAreaHa.ToString("N2") ha</dd>
                            <dt class="col-5">Soil · irrigation</dt><dd class="col-7">@Selected.SoilType · @Selected.Irrigation</dd>
                            <dt class="col-5">Crop status</dt><dd class="col-7">@Selected.CurrentCropStatus</dd>
                            <dt class="col-5">Programme</dt>
                            <dd class="col-7">
                                <span class="badge @BandFor(Selected.Id).Css">@BandFor(Selected.Id).Label</span>
                                @if (progress.PlanCount > 0)
                                {
                                    <span class="ms-1">@progress.Percent.ToString("N1")% of @progress.PlanCount activities</span>
                                }
                            </dd>
                            <dt class="col-5">Coordinates</dt>
                            <dd class="col-7 font-monospace">@Coordinates(Selected)</dd>
                            <dt class="col-5">Map reference</dt><dd class="col-7">@(Selected.MapReference ?? "—")</dd>
                        </dl>
                        <a class="btn btn-sm btn-success" target="_blank" rel="noopener"
                           href="@BlockMapProjection.GoogleMapsLink(Selected.Latitude!.Value, Selected.Longitude!.Value)">
                            Open in Google Maps
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th><th>Name</th><th>Farm</th>
                        <th class="text-end">Plantable (ha)</th>
                        <th>Programme</th><th>Coordinates</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in located)
                    {
                        <tr class="@(block.Id == selectedId ? "table-active" : null)"
                            style="cursor:pointer" @onclick="() => Select(block.Id)">
                            <td class="fw-semibold">@block.Code</td>
                            <td>@block.Name</td>
                            <td>@block.FarmName</td>
                            <td class="text-end">@block.PlantableAreaHa.ToString("N2")</td>
                            <td><span class="badge @BandFor(block.Id).Css">@BandFor(block.Id).Label</span></td>
                            <td class="font-monospace small">@Coordinates(block)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-link py-0" target="_blank" rel="noopener"
                                   @onclick:stopPropagation="true"
                                   href="@BlockMapProjection.GoogleMapsLink(block.Latitude!.Value, block.Longitude!.Value)">Map ↗</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private const string MapElementId = "sgc-block-map";

    private bool loading = true;
    private string? error;
    private string? errorCode;

    /// <summary>How long to wait for the Maps script before showing the plot instead.</summary>
    private static readonly TimeSpan MapStartTimeout = TimeSpan.FromSeconds(8);

    private enum MapMode { Starting, Google, Fallback }

    private MapMode mode = MapMode.Starting;

    /// <summary>Why the built-in plot is showing; set only in <see cref="MapMode.Fallback"/>.</summary>
    private string? fallbackReason;

    private IReadOnlyList<PlantationBlockDto> located = Array.Empty<PlantationBlockDto>();
    private int skipped;
    private Dictionary<int, (decimal Percent, int PlanCount)> progressByBlock = new();
    private BlockMapPlot plot = default!;
    private decimal centreLatitude, centreLongitude;
    private int? selectedId;

    private DotNetObjectReference<BlockMap>? selfRef;
    private bool mapRequested;

    private PlantationBlockDto? Selected => selectedId is null ? null : located.FirstOrDefault(b => b.Id == selectedId);

    private static readonly (string Key, string Label, string Colour, string Css)[] Bands =
    {
        ("done", "Complete",    "#2e7d32", "text-bg-success"),
        ("part", "In progress", "#e08b00", "text-bg-warning"),
        ("plan", "Planned",     "#0a6ed1", "text-bg-info"),
        ("none", "Not planned", "#8c8c8c", "text-bg-secondary")
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var blocks = (await Api.GetBlocksAsync(null, null, new QueryParameters { PageSize = 500 })).Items;
            var plans = (await Api.GetActivityPlansAsync(null, null, null, new QueryParameters { PageSize = 500 })).Items;

            progressByBlock = plans
                .GroupBy(p => p.BlockId)
                .ToDictionary(g => g.Key, g =>
                {
                    // Area-weighted, because a block's activities do not all cover the same area
                    // once a plan has been adjusted. Every activity counts: this is progress
                    // through the programme, not through planting alone.
                    var area = g.Sum(p => p.PlannedAreaHa);
                    var percent = area > 0
                        ? g.Sum(p => p.PlannedAreaHa * p.CompletionPercent) / area
                        : g.Average(p => p.CompletionPercent);
                    return (Math.Round(percent, 2), g.Count());
                });

            located = blocks.Where(b => b.Latitude is not null && b.Longitude is not null)
                            .OrderBy(b => b.Code, StringComparer.Ordinal)
                            .ToList();
            skipped = blocks.Count - located.Count;

            plot = BlockMapProjection.Project(
                located.Select(b => (b.Id, (double)b.Latitude!.Value, (double)b.Longitude!.Value)));
            centreLatitude = (decimal)plot.CentreLatitude;
            centreLongitude = (decimal)plot.CentreLongitude;

            if (selectedId is not null && located.All(b => b.Id != selectedId)) { selectedId = null; }
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The container only exists once the blocks have loaded, so this cannot run on the first
        // render; it runs on the one after the load completes, and again after every reload.
        if (loading || located.Count == 0 || mapRequested) { return; }
        mapRequested = true;
        await TryRenderGoogleMapAsync();
    }

    private async Task TryRenderGoogleMapAsync()
    {
        mode = MapMode.Starting;
        fallbackReason = null;
        StateHasChanged();

        selfRef ??= DotNetObjectReference.Create(this);
        var maxArea = located.Max(b => b.PlantableAreaHa);

        var payload = new
        {
            apiKey = Config["GoogleMaps:ApiKey"],
            mapTypeId = Config["GoogleMaps:MapType"],
            selectedId,
            blocks = located.Select(b => new
            {
                id = b.Id,
                code = b.Code,
                lat = (double)b.Latitude!.Value,
                lng = (double)b.Longitude!.Value,
                // The Google marker symbol is scaled in pixels of radius, on a different scale
                // from the SVG plot's own coordinate space.
                scale = BlockMapProjection.Radius(b.PlantableAreaHa, maxArea, 7d, 9d),
                colour = BandFor(b.Id).Colour,
                tooltip = Tooltip(b)
            })
        };

        var call = Js.InvokeAsync<MapResult>("sgcBlockMap.render", MapElementId, selfRef, payload).AsTask();

        // Loading Google's script can take a while, or hang outright on a network that silently
        // drops the connection. Rather than sit on a blank panel — or, worse, leave a stale
        // message up — the plot goes in after a few seconds and is replaced if the map arrives.
        if (await Task.WhenAny(call, Task.Delay(MapStartTimeout)) != call)
        {
            ShowPlot("The map is taking longer than usual to start.");
            StateHasChanged();
        }

        try
        {
            var result = await call;
            if (result.Ok) { mode = MapMode.Google; fallbackReason = null; }
            else { ShowPlot(result.Reason); }
        }
        catch (JSException ex)
        {
            ShowPlot(ex.Message);
        }
        catch (Exception ex) when (ex is InvalidOperationException or TaskCanceledException or ObjectDisposedException)
        {
            // Interop is unavailable during pre-render and once the page has been navigated away from.
            ShowPlot("The map could not be started in this browser.");
        }

        StateHasChanged();
    }

    private void ShowPlot(string? reason)
    {
        mode = MapMode.Fallback;
        fallbackReason = reason ?? "The map is unavailable.";
    }

    private Task RetryGoogleMap() => TryRenderGoogleMapAsync();

    private async Task Select(int blockId)
    {
        selectedId = blockId;
        if (mode == MapMode.Google)
        {
            try { await Js.InvokeAsync<bool>("sgcBlockMap.focus", blockId, 15); }
            catch (JSException) { /* the panel is still correct without the pan */ }
        }
    }

    private void OnMarkerKey(KeyboardEventArgs e, int blockId)
    {
        if (e.Key is "Enter" or " ") { selectedId = blockId; }
    }

    /// <summary>Called from blockmap.js when a Google marker is clicked.</summary>
    [JSInvokable]
    public void OnMarkerSelected(int blockId)
    {
        selectedId = blockId;
        StateHasChanged();
    }

    private (decimal Percent, int PlanCount) Progress(int blockId) =>
        progressByBlock.TryGetValue(blockId, out var p) ? p : (0m, 0);

    private (string Label, string Colour, string Css) BandFor(int blockId)
    {
        var (percent, planCount) = Progress(blockId);
        var key = planCount == 0 ? "none" : percent >= 100m ? "done" : percent > 0m ? "part" : "plan";
        var band = Bands.First(b => b.Key == key);
        return (band.Label, band.Colour, band.Css);
    }

    private string Tooltip(PlantationBlockDto b) =>
        $"{b.Name} · {b.PlantableAreaHa:N2} ha · {BandFor(b.Id).Label}";

    private sealed record Marker(PlantationBlockDto Block, double X, double Y, double Radius, string Colour, string Tooltip);

    private IEnumerable<Marker> Markers()
    {
        var maxArea = located.Max(b => b.PlantableAreaHa);
        var points = plot.Points.ToDictionary(p => p.BlockId);
        foreach (var block in located)
        {
            if (!points.TryGetValue(block.Id, out var point)) { continue; }
            yield return new Marker(block, point.X, point.Y,
                BlockMapProjection.Radius(block.PlantableAreaHa, maxArea),
                BandFor(block.Id).Colour, Tooltip(block));
        }
    }

    /// <summary>Farm names, placed above the topmost block of each farm rather than on top of them.</summary>
    private IEnumerable<(string Name, double X, double Y)> FarmLabels()
    {
        var points = plot.Points.ToDictionary(p => p.BlockId);
        foreach (var farm in located.GroupBy(b => b.FarmName))
        {
            var own = farm.Where(b => points.ContainsKey(b.Id)).Select(b => points[b.Id]).ToList();
            if (own.Count == 0) { continue; }
            yield return (farm.Key, own.Average(p => p.X), own.Min(p => p.Y) - 30d);
        }
    }

    /// <summary>Trims the trailing zeros the decimal(9,6) column carries; 28.232000 reads as noise.</summary>
    private static string Coordinates(PlantationBlockDto b) =>
        $"{b.Latitude!.Value.ToString("0.######")}, {b.Longitude!.Value.ToString("0.######")}";

    private static string Fmt(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private sealed record MapResult(bool Ok, string? Reason);

    public async ValueTask DisposeAsync()
    {
        try { await Js.InvokeVoidAsync("sgcBlockMap.dispose"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
        selfRef?.Dispose();
    }
}
