@page "/activities"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Planting activities</PageTitle>

<h1 class="h4 mb-3">Activity master and dependency setup</h1>
<p class="text-secondary small">
    Activities are configuration, not code. The plan generator reads whatever is active here,
    and a dependent activity cannot start before its blocking predecessor finishes.
</p>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(tab == "activities" ? "active" : "")" @onclick='() => tab = "activities"'>Activities</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "dependencies" ? "active" : "")" @onclick="ShowDependencies">Dependencies</button></li>
</ul>

@if (tab == "activities")
{
    <CrudTable TItem="PlantingActivityDto" TUpsert="PlantingActivityUpsertDto"
               Title="Planting activities"
               Columns="@(new[] { "Seq", "Code", "Name", "Category", "Crop", "Offset (d)", "Cap/day (ha)", "h/ha", "Labor-days/ha", "Requires", "Active" })"
               RowTemplate="RenderRow"
               EditorTemplate="RenderEditor"
               ToEditModel="ToEditModel"
               NewModel="@(() => new PlantingActivityUpsertDto { CompanyId = companies.FirstOrDefault()?.Id ?? 0 })"
               OnLoad="@(q => Api.GetActivitiesAsync(q))"
               OnCreate="@(dto => Api.CreateActivityAsync(dto))"
               OnUpdate="@((id, dto) => Api.UpdateActivityAsync(id, dto))"
               OnDelete="@(id => Api.DeleteActivityAsync(id))"
               IdSelector="@(a => a.Id)" />
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">Activity dependencies</div>
        <div class="card-body">
            <ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />
            <SuccessToast Message="@success" OnDismiss="() => success = null" />

            <div class="row g-2 align-items-end border rounded p-3 mb-3 bg-light">
                <div class="col-md-4">
                    <label class="form-label">Activity</label>
                    <select class="form-select" @bind="newDependency.ActivityId">
                        <option value="0">— select —</option>
                        @foreach (var activity in activityLookup)
                        {
                            <option value="@activity.Id">@activity.Display</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Must wait for</label>
                    <select class="form-select" @bind="newDependency.PredecessorActivityId">
                        <option value="0">— select —</option>
                        @foreach (var activity in activityLookup)
                        {
                            <option value="@activity.Id">@activity.Display</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Lag (days)</label>
                    <input type="number" class="form-control" @bind="newDependency.LagDays" min="0" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="blocking" @bind="newDependency.IsBlocking" />
                        <label class="form-check-label small" for="blocking">Blocking</label>
                    </div>
                    <button class="btn btn-success btn-sm ms-auto" @onclick="AddDependency" disabled="@busy">Add</button>
                </div>
            </div>

            @if (busy && dependencies.Count == 0)
            {
                <LoadingPanel />
            }
            else if (dependencies.Count == 0)
            {
                <div class="text-secondary small">No dependencies are configured.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Activity</th>
                                <th>Waits for</th>
                                <th class="text-end">Lag (days)</th>
                                <th>Blocking</th>
                                <th>Remarks</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dependency in dependencies)
                            {
                                <tr>
                                    <td>@dependency.ActivityName</td>
                                    <td>@dependency.PredecessorActivityName</td>
                                    <td class="text-end">@dependency.LagDays</td>
                                    <td>@(dependency.IsBlocking ? "Yes" : "Advisory")</td>
                                    <td class="small">@dependency.Remarks</td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveDependency(dependency.Id)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private string tab = "activities";
    private IReadOnlyList<LookupDto> companies = Array.Empty<LookupDto>();
    private IReadOnlyList<LookupDto> activityLookup = Array.Empty<LookupDto>();
    private IReadOnlyList<ActivityDependencyDto> dependencies = Array.Empty<ActivityDependencyDto>();
    private ActivityDependencyUpsertDto newDependency = new();
    private string? error;
    private string? errorCode;
    private string? success;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        companies = await Api.LookupAsync("companies");
        activityLookup = await Api.LookupAsync("activities");
    }

    private async Task ShowDependencies()
    {
        tab = "dependencies";
        await LoadDependencies();
    }

    private async Task LoadDependencies()
    {
        try
        {
            busy = true;
            error = null;
            activityLookup = await Api.LookupAsync("activities");
            dependencies = await Api.GetDependenciesAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddDependency()
    {
        if (newDependency.ActivityId == 0 || newDependency.PredecessorActivityId == 0)
        {
            error = "Select both the activity and its predecessor.";
            errorCode = "INCOMPLETE";
            return;
        }

        try
        {
            busy = true;
            error = null;
            await Api.AddDependencyAsync(newDependency);
            success = "Dependency added.";
            newDependency = new ActivityDependencyUpsertDto();
            await LoadDependencies();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveDependency(int id)
    {
        try
        {
            busy = true;
            await Api.RemoveDependencyAsync(id);
            success = "Dependency removed.";
            await LoadDependencies();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private PlantingActivityUpsertDto ToEditModel(PlantingActivityDto a) => new()
    {
        CompanyId = a.CompanyId,
        Code = a.Code,
        Name = a.Name,
        Category = a.Category,
        SequenceNo = a.SequenceNo,
        ApplicableCropType = a.ApplicableCropType,
        StandardStartDayOffset = a.StandardStartDayOffset,
        StandardCapacityPerHour = a.StandardCapacityPerHour,
        StandardCapacityPerDay = a.StandardCapacityPerDay,
        StandardDurationPerHa = a.StandardDurationPerHa,
        StandardLaborDaysPerHa = a.StandardLaborDaysPerHa,
        IsMandatory = a.IsMandatory,
        RequiresTractor = a.RequiresTractor,
        RequiresEquipment = a.RequiresEquipment,
        RequiresMaterial = a.RequiresMaterial,
        RequiresLabor = a.RequiresLabor,
        AllowOverlap = a.AllowOverlap,
        DefaultEquipmentCategory = a.DefaultEquipmentCategory,
        IsActive = a.IsActive,
        RowVersion = a.RowVersion
    };

    private static string Requirements(PlantingActivityDto a)
    {
        var parts = new List<string>();
        if (a.RequiresTractor) parts.Add("tractor");
        if (a.RequiresEquipment) parts.Add("equipment");
        if (a.RequiresMaterial) parts.Add("material");
        if (a.RequiresLabor) parts.Add("labor");
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }

    private RenderFragment<PlantingActivityDto> RenderRow => activity =>
    @<text>
        <td class="text-end">@activity.SequenceNo</td>
        <td>@activity.Code</td>
        <td>@activity.Name</td>
        <td>@activity.Category</td>
        <td>@activity.ApplicableCropType</td>
        <td class="text-end">@activity.StandardStartDayOffset</td>
        <td class="text-end">@activity.StandardCapacityPerDay.ToString("N2")</td>
        <td class="text-end">@activity.StandardDurationPerHa.ToString("N2")</td>
        <td class="text-end">@activity.StandardLaborDaysPerHa.ToString("N2")</td>
        <td class="small">@Requirements(activity)</td>
        <td>@(activity.IsActive ? "Yes" : "No")</td>
    </text>;

    private RenderFragment<PlantingActivityUpsertDto> RenderEditor => model =>
    @<text>
        <div class="col-md-3">
            <label class="form-label">Company</label>
            <InputSelect class="form-select" @bind-Value="model.CompanyId">
                @foreach (var company in companies)
                {
                    <option value="@company.Id">@company.Display</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2"><label class="form-label">Code</label><InputText class="form-control" @bind-Value="model.Code" /></div>
        <div class="col-md-5"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="model.Name" /></div>
        <div class="col-md-2"><label class="form-label">Sequence</label><InputNumber class="form-control" @bind-Value="model.SequenceNo" /></div>

        <div class="col-md-3">
            <label class="form-label">Category</label>
            <InputSelect class="form-select" @bind-Value="model.Category">
                @foreach (var category in Enum.GetValues<ActivityCategory>())
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-3">
            <label class="form-label">Applicable crop type</label>
            <InputSelect class="form-select" @bind-Value="model.ApplicableCropType">
                @foreach (var crop in Enum.GetValues<CropType>())
                {
                    <option value="@crop">@crop</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-3">
            <label class="form-label">Default equipment</label>
            <InputSelect class="form-select" @bind-Value="model.DefaultEquipmentCategory">
                <option value="">— none —</option>
                @foreach (var category in Enum.GetValues<EquipmentCategory>())
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-3"><label class="form-label">Start day offset</label><InputNumber class="form-control" @bind-Value="model.StandardStartDayOffset" /></div>

        <div class="col-md-3"><label class="form-label">Capacity per hour (ha)</label><InputNumber class="form-control" @bind-Value="model.StandardCapacityPerHour" step="0.01" /></div>
        <div class="col-md-3"><label class="form-label">Capacity per day (ha)</label><InputNumber class="form-control" @bind-Value="model.StandardCapacityPerDay" step="0.01" /></div>
        <div class="col-md-3"><label class="form-label">Duration per ha (hours)</label><InputNumber class="form-control" @bind-Value="model.StandardDurationPerHa" step="0.01" /></div>
        <div class="col-md-3"><label class="form-label">Labor-days per ha</label><InputNumber class="form-control" @bind-Value="model.StandardLaborDaysPerHa" step="0.01" /></div>

        <div class="col-12 d-flex flex-wrap gap-3">
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsMandatory" id="mandatory" /><label class="form-check-label" for="mandatory">Mandatory</label></div>
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.RequiresTractor" id="reqTractor" /><label class="form-check-label" for="reqTractor">Requires tractor</label></div>
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.RequiresEquipment" id="reqEquip" /><label class="form-check-label" for="reqEquip">Requires equipment</label></div>
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.RequiresMaterial" id="reqMaterial" /><label class="form-check-label" for="reqMaterial">Requires material</label></div>
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.RequiresLabor" id="reqLabor" /><label class="form-check-label" for="reqLabor">Requires labor</label></div>
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.AllowOverlap" id="overlap" /><label class="form-check-label" for="overlap">Allow overlapping</label></div>
            <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="activityActive" /><label class="form-check-label" for="activityActive">Active</label></div>
        </div>
    </text>;
}
