@page "/"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Dashboard — Sugarcane Planting Planning</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Planting dashboard</h1>
        <small class="text-secondary">@(data?.SeasonName ?? "…") · generated @(data?.GeneratedOn.ToString("yyyy-MM-dd"))</small>
    </div>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width:auto" @onchange="OnSeasonChanged" aria-label="Season">
            <option value="">Current open season</option>
            @foreach (var season in seasons)
            {
                <option value="@season.Id" selected="@(season.Id == seasonId)">@season.Display</option>
            }
        </select>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Load" disabled="@busy">Refresh</button>
    </div>
</div>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

@if (busy && data is null)
{
    <LoadingPanel Message="Aggregating the plan…" />
}
else if (data is null)
{
    <div class="alert alert-secondary">No planning data is available yet.</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <KpiCard Title="Projected area" Value="@data.TotalProjectedAreaHa.ToString("N0")" Unit="ha"
                     Caption="@($"{data.NewPlantingAreaHa:N0} ha new · {data.RatoonAreaHa:N0} ha ratoon")" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Expected production" Value="@data.TotalExpectedProductionTons.ToString("N0")" Unit="t"
                     Caption="After the expected loss percentage" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Planted to date" Value="@data.ActualPlantedAreaHa.ToString("N0")" Unit="ha"
                     Caption="@($"Plan to date {data.PlannedAreaToDateHa:N0} ha")"
                     ProgressPercent="data.OverallCompletionPercent" />
        </div>
        <div class="col-6 col-lg-3">
            <KpiCard Title="Overall completion" Value="@data.OverallCompletionPercent.ToString("N1")" Unit="%"
                     Caption="@($"{data.DelayedActivityCount} delayed · {data.AtRiskBlockCount} blocks at risk")"
                     ProgressPercent="data.OverallCompletionPercent"
                     ProgressClass="@(data.OverallCompletionPercent >= 80 ? "bg-success" : "bg-warning")" />
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Monthly planting target versus actual</div>
                <div class="card-body">
                    @if (data.MonthlyTargets.Count == 0)
                    {
                        <div class="text-secondary small">No activity plans have been generated yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Month</th>
                                        <th class="text-end">Target (ha)</th>
                                        <th class="text-end">Actual (ha)</th>
                                        <th style="min-width:160px">Completion</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var period in data.MonthlyTargets)
                                    {
                                        <tr>
                                            <td>@period.Label</td>
                                            <td class="text-end">@period.TargetAreaHa.ToString("N1")</td>
                                            <td class="text-end">@period.ActualAreaHa.ToString("N1")</td>
                                            <td><ProgressBarCell Percent="period.CompletionPercent" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Resource requirement versus availability</div>
                <div class="card-body">
                    @if (data.ResourceGaps.Count == 0)
                    {
                        <div class="text-secondary small">No resource requirement has been calculated yet.</div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Resource</th>
                                    <th class="text-end">Required</th>
                                    <th class="text-end">Available</th>
                                    <th class="text-end">Shortage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gap in data.ResourceGaps)
                                {
                                    <tr>
                                        <td>@gap.ResourceType — @gap.Name</td>
                                        <td class="text-end">@gap.Required.ToString("N0")</td>
                                        <td class="text-end">@gap.Available.ToString("N0")</td>
                                        <td class="text-end">@gap.Shortage.ToString("N0")</td>
                                        <td><StatusBadge Capacity="gap.Status" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Area by farm</div>
                <div class="card-body">
                    @if (data.AreaByFarm.Count == 0)
                    {
                        <div class="text-secondary small">No projection lines yet.</div>
                    }
                    else
                    {
                        @foreach (var farm in data.AreaByFarm)
                        {
                            var share = data.TotalProjectedAreaHa <= 0 ? 0 : farm.PlannedAreaHa / data.TotalProjectedAreaHa * 100m;
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small">
                                    <span>@farm.Name</span>
                                    <span class="text-secondary">@farm.PlannedAreaHa.ToString("N0") ha (@share.ToString("N0")%)</span>
                                </div>
                                <div class="progress" style="height:8px" role="progressbar"
                                     aria-valuenow="@((int)share)" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width:@share.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Material requirement by category</div>
                <div class="card-body">
                    @if (data.MaterialSummary.Count == 0)
                    {
                        <div class="text-secondary small">No material requirement has been calculated yet.</div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-end">Required</th>
                                    <th class="text-end">Net available</th>
                                    <th class="text-end">Shortage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var material in data.MaterialSummary)
                                {
                                    <tr>
                                        <td>@material.CategoryName</td>
                                        <td class="text-end">@material.TotalRequirement.ToString("N0")</td>
                                        <td class="text-end">@material.NetAvailable.ToString("N0")</td>
                                        <td class="text-end">@material.Shortage.ToString("N0")</td>
                                        <td><StatusBadge Capacity="material.Status" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Delayed activities</div>
                <div class="card-body p-0">
                    @if (data.DelayedActivities.Count == 0)
                    {
                        <div class="p-3 text-secondary small">Nothing is running late.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Block</th>
                                        <th>Activity</th>
                                        <th class="text-end">Days late</th>
                                        <th>Completion</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var delayed in data.DelayedActivities.Take(10))
                                    {
                                        <tr>
                                            <td>@delayed.BlockName</td>
                                            <td>@delayed.ActivityName</td>
                                            <td class="text-end text-danger fw-semibold">@delayed.DaysLate</td>
                                            <td style="min-width:140px"><ProgressBarCell Percent="delayed.CompletionPercent" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Blocks at risk</div>
                <div class="card-body p-0">
                    @if (data.AtRiskBlocks.Count == 0)
                    {
                        <div class="p-3 text-secondary small">Every block is on schedule.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Block</th>
                                        <th>Farm</th>
                                        <th class="text-end">Area (ha)</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var block in data.AtRiskBlocks.Take(10))
                                    {
                                        <tr>
                                            <td>@block.BlockCode</td>
                                            <td>@block.FarmName</td>
                                            <td class="text-end">@block.PlannedAreaHa.ToString("N1")</td>
                                            <td class="small">@block.RiskReason</td>
                                            <td><StatusBadge Capacity="block.Status" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardDto? data;
    private IReadOnlyList<LookupDto> seasons = Array.Empty<LookupDto>();
    private int? seasonId;
    private string? error;
    private string? errorCode;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        seasons = await Api.LookupAsync("seasons");
        await Load();
    }

    private async Task Load()
    {
        try
        {
            busy = true;
            error = null;
            data = await Api.GetDashboardAsync(seasonId);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnSeasonChanged(ChangeEventArgs args)
    {
        seasonId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await Load();
    }
}
