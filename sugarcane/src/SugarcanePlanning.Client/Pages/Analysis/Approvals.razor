@page "/approvals"
@attribute [Authorize]
@inject PlanningApi Api

<PageTitle>Approvals & revision history</PageTitle>

<h1 class="h4 mb-1">Approval and revision history</h1>
<p class="text-secondary small">
    Every revision copies the approved version, keeps the previous one read-only and records the
    reason, the creator, the reviewer and the approver.
</p>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Projection</label>
                <select class="form-select form-select-sm" @onchange="OnProjectionChanged">
                    <option value="">Select a projection…</option>
                    @foreach (var projection in projections)
                    {
                        <option value="@projection.Id" selected="@(projection.Id == projectionId)">@projection.Code (@projection.Name)</option>
                    }
                </select>
            </div>
            @if (versions.Count > 1)
            {
                <div class="col-md-3">
                    <label class="form-label">Compare from</label>
                    <select class="form-select form-select-sm" @onchange="e => compareFrom = ParseId(e)">
                        @foreach (var version in versions)
                        {
                            <option value="@version.Id" selected="@(version.Id == compareFrom)">v@version.Version (@version.Status)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Compare to</label>
                    <select class="form-select form-select-sm" @onchange="e => compareTo = ParseId(e)">
                        @foreach (var version in versions)
                        {
                            <option value="@version.Id" selected="@(version.Id == compareTo)">v@version.Version (@version.Status)</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 text-end">
                    <button class="btn btn-success btn-sm" @onclick="Compare" disabled="@busy">Compare</button>
                </div>
            }
        </div>
    </div>
</div>

@if (projectionId is null)
{
    <div class="alert alert-secondary">Select a projection to see its version chain.</div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Version chain</div>
        <div class="card-body">
            @if (versions.Count == 0)
            {
                <LoadingPanel />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="text-end">Version</th>
                                <th>Status</th>
                                <th>Projection date</th>
                                <th class="text-end">Area (ha)</th>
                                <th class="text-end">Production (t)</th>
                                <th>Prepared by</th>
                                <th>Approved by</th>
                                <th>Approved at</th>
                                <th>Current</th>
                                <th class="text-end">Open</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var version in versions)
                            {
                                <tr>
                                    <td class="text-end fw-semibold">@version.Version</td>
                                    <td><StatusBadge Projection="version.Status" /></td>
                                    <td class="small">@version.ProjectionDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">@version.TotalProjectedAreaHa.ToString("N2")</td>
                                    <td class="text-end">@version.TotalExpectedProductionTons.ToString("N2")</td>
                                    <td>@version.PreparedBy</td>
                                    <td>@version.ApprovedBy</td>
                                    <td class="small">@(version.ApprovedAtUtc?.ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td>@(version.IsCurrentVersion ? "Yes" : "")</td>
                                    <td class="text-end">
                                        <a class="btn btn-outline-secondary btn-sm" href="projections/@version.Id">Open</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (detail is not null && detail.ApprovalHistory.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">Approval history of the selected version</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>When</th>
                                <th>Action</th>
                                <th>From → to</th>
                                <th>By</th>
                                <th>Comments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in detail.ApprovalHistory)
                            {
                                <tr>
                                    <td class="small">@entry.ActionAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@entry.Action</td>
                                    <td class="small">@entry.FromStatus → @entry.ToStatus</td>
                                    <td>@entry.ActionBy</td>
                                    <td class="small">@entry.Comments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (comparison is not null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                Comparison v@comparison.FromVersion → v@comparison.ToVersion
                <span class="text-secondary small fw-normal ms-2">
                    @comparison.FromTotalAreaHa.ToString("N2") ha → @comparison.ToTotalAreaHa.ToString("N2") ha
                </span>
            </div>
            <div class="card-body">
                @if (comparison.Differences.Count == 0)
                {
                    <div class="text-secondary small">The two versions are identical.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Scope</th>
                                    <th>Block</th>
                                    <th>Field</th>
                                    <th>Old value</th>
                                    <th>New value</th>
                                    <th>Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var difference in comparison.Differences)
                                {
                                    <tr>
                                        <td>@difference.Scope</td>
                                        <td>@difference.BlockCode</td>
                                        <td>@difference.Field</td>
                                        <td class="text-secondary">@difference.OldValue</td>
                                        <td class="fw-semibold">@difference.NewValue</td>
                                        <td>
                                            <span class="badge @(difference.ChangeType switch { "Added" => "text-bg-success", "Removed" => "text-bg-danger", _ => "text-bg-info" })">
                                                @difference.ChangeType
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<LookupDto> projections = Array.Empty<LookupDto>();
    private IReadOnlyList<ProjectionSummaryDto> versions = Array.Empty<ProjectionSummaryDto>();
    private ProjectionDetailDto? detail;
    private VersionComparisonDto? comparison;
    private int? projectionId;
    private int? compareFrom;
    private int? compareTo;
    private string? error;
    private string? errorCode;
    private bool busy;

    protected override async Task OnInitializedAsync() => projections = await Api.LookupAsync("projections");

    private static int? ParseId(ChangeEventArgs args)
        => int.TryParse(args.Value?.ToString(), out var id) ? id : null;

    private async Task OnProjectionChanged(ChangeEventArgs args)
    {
        projectionId = ParseId(args);
        comparison = null;
        if (projectionId is null) return;

        try
        {
            busy = true;
            error = null;
            versions = await Api.GetVersionsAsync(projectionId.Value);
            detail = await Api.GetProjectionAsync(projectionId.Value);
            compareFrom = versions.FirstOrDefault()?.Id;
            compareTo = versions.LastOrDefault()?.Id;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Compare()
    {
        if (compareFrom is null || compareTo is null) return;
        try
        {
            busy = true;
            error = null;
            comparison = await Api.CompareVersionsAsync(compareFrom.Value, compareTo.Value);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }
}
