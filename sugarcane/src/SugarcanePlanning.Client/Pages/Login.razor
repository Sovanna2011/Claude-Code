@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Navigation
@attribute [AllowAnonymous]

<PageTitle>Sign in — Sugarcane Planting Planning</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="card shadow-sm" style="width:min(420px, 94vw)">
        <div class="card-body p-4">
            <h1 class="h4 mb-1">Sugarcane Planting Planning</h1>
            <p class="text-secondary small mb-4">Sign in to plan and control planting operations.</p>

            <ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

            <EditForm Model="model" OnValidSubmit="SignIn" FormName="login">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="userName">User name</label>
                    <InputText id="userName" class="form-control" @bind-Value="model.UserName" autocomplete="username" />
                    <ValidationMessage For="() => model.UserName" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="model.Password"
                               autocomplete="current-password" />
                    <ValidationMessage For="() => model.Password" class="text-danger small" />
                </div>

                <button class="btn btn-success w-100" type="submit" disabled="@busy">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Sign in
                </button>
            </EditForm>

            <hr class="my-4" />
            <details>
                <summary class="small text-secondary">Demo accounts</summary>
                <div class="small text-secondary mt-2">
                    Password <code>Planner#2026</code> for every account:
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @foreach (var account in DemoAccounts)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Fill(account)">
                                @account
                            </button>
                        }
                    </div>
                </div>
            </details>
        </div>
    </div>
</div>

@code {
    private static readonly string[] DemoAccounts =
    {
        "admin", "director", "manager", "farmmanager", "planner",
        "machinery", "materials", "supervisor", "approver", "viewer"
    };

    private readonly LoginModel model = new();
    private string? error;
    private string? errorCode;
    private bool busy;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private void Fill(string userName)
    {
        model.UserName = userName;
        model.Password = "Planner#2026";
    }

    private async Task SignIn()
    {
        try
        {
            busy = true;
            error = null;
            await Auth.LoginAsync(new LoginRequest { UserName = model.UserName, Password = model.Password });
            Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "" : Uri.UnescapeDataString(ReturnUrl), replace: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Client-side shape of the sign-in form.</summary>
    private class LoginModel
    {
        [Required(ErrorMessage = "Enter your user name.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
