@*
    Router with authentication: unauthenticated users are sent to the sign-in page,
    and a user without the required role sees an explanatory message rather than a blank screen.
*@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container py-5">
                            <div class="alert alert-warning">
                                <h5 class="alert-heading">Not authorised</h5>
                                <p class="mb-0">
                                    Your roles do not include permission for this screen.
                                    Contact your system administrator if you need access.
                                </p>
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <LoadingPanel Message="Checking your permissions…" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container py-5">
                    <div class="alert alert-secondary">
                        <h5 class="alert-heading">Page not found</h5>
                        <p class="mb-0">The address you requested does not exist in this application.</p>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
