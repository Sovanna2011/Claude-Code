@typeparam TItem

@* Paging controls bound to a PagedResult<T>; also lets the user change the page size. *@
@if (Result is not null && Result.TotalCount > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <small class="text-secondary">
            Showing @(((Result.Page - 1) * Result.PageSize) + 1)–@(Math.Min(Result.Page * Result.PageSize, Result.TotalCount))
            of @Result.TotalCount
        </small>

        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" style="width:auto"
                    value="@Result.PageSize" @onchange="HandlePageSizeChanged" aria-label="Rows per page">
                @foreach (var size in new[] { 10, 25, 50, 100 })
                {
                    <option value="@size">@size / page</option>
                }
            </select>

            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Result.HasPrevious ? "" : "disabled")">
                        <button class="page-link" @onclick="() => GoTo(Result.Page - 1)" disabled="@(!Result.HasPrevious)">Previous</button>
                    </li>
                    @foreach (var pageNo in PageNumbers())
                    {
                        <li class="page-item @(pageNo == Result.Page ? "active" : "")">
                            <button class="page-link" @onclick="() => GoTo(pageNo)">@pageNo</button>
                        </li>
                    }
                    <li class="page-item @(Result.HasNext ? "" : "disabled")">
                        <button class="page-link" @onclick="() => GoTo(Result.Page + 1)" disabled="@(!Result.HasNext)">Next</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public PagedResult<TItem>? Result { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    /// <summary>At most seven page buttons, centred on the current page.</summary>
    private IEnumerable<int> PageNumbers()
    {
        if (Result is null) yield break;
        var first = Math.Max(1, Result.Page - 3);
        var last = Math.Min(Result.TotalPages, first + 6);
        first = Math.Max(1, last - 6);
        for (var p = first; p <= last; p++) yield return p;
    }

    private async Task GoTo(int page)
    {
        if (Result is null || page < 1 || page > Result.TotalPages || page == Result.Page) return;
        await OnPageChanged.InvokeAsync(page);
    }

    private async Task HandlePageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size))
            await OnPageSizeChanged.InvokeAsync(size);
    }
}
