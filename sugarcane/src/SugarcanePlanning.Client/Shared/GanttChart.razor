@*
    Gantt-style timeline for the activity plan (section 7). Bars are positioned with a CSS grid
    whose columns are days, so it renders without any charting library.
*@
@if (View is null || View.Bars.Count == 0)
{
    <div class="alert alert-secondary">No activity plans to display for this selection.</div>
}
else
{
    <div class="table-responsive gantt-scroll">
        <table class="table table-sm table-bordered align-middle mb-0 gantt-table">
            <thead class="table-light">
                <tr>
                    <th class="gantt-label">Block / activity</th>
                    <th>
                        <div class="gantt-axis" style="grid-template-columns:repeat(@TotalDays, minmax(4px, 1fr))">
                            @foreach (var tick in Ticks())
                            {
                                <div class="gantt-tick" style="grid-column:@(tick.Offset + 1) / span @tick.Span">
                                    <small>@tick.Label</small>
                                </div>
                            }
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in View.Bars.GroupBy(b => b.BlockName))
                {
                    <tr class="table-light">
                        <td colspan="2" class="fw-semibold">@group.Key</td>
                    </tr>
                    @foreach (var bar in group.OrderBy(b => b.SequenceNo))
                    {
                        <tr>
                            <td class="gantt-label">
                                <span class="text-secondary me-1">@bar.SequenceNo.</span>@bar.ActivityName
                            </td>
                            <td>
                                <div class="gantt-axis" style="grid-template-columns:repeat(@TotalDays, minmax(4px, 1fr))">
                                    <div class="gantt-bar @BarClass(bar.Status)"
                                         style="grid-column:@(Offset(bar.Start) + 1) / span @Span(bar)"
                                         title="@bar.ActivityName: @bar.Start.ToString("yyyy-MM-dd") → @bar.End.ToString("yyyy-MM-dd"), @bar.PlannedAreaHa.ToString("N2") ha">
                                        <span class="gantt-fill" style="width:@(Math.Min(100m, bar.CompletionPercent).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                        <span class="gantt-text">@bar.PlannedAreaHa.ToString("N0") ha</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap gap-3 mt-2 small text-secondary">
        <span><span class="gantt-key bg-secondary"></span> Planned</span>
        <span><span class="gantt-key bg-info"></span> Scheduled</span>
        <span><span class="gantt-key bg-primary"></span> In progress</span>
        <span><span class="gantt-key bg-success"></span> Completed</span>
        <span><span class="gantt-key bg-danger"></span> Delayed</span>
    </div>
}

@code {
    [Parameter] public GanttViewDto? View { get; set; }

    private int TotalDays => View is null ? 1 : Math.Max(1, View.RangeEnd.DayNumber - View.RangeStart.DayNumber + 1);

    private int Offset(DateOnly date) => View is null ? 0 : Math.Max(0, date.DayNumber - View.RangeStart.DayNumber);

    private int Span(GanttBarDto bar) => Math.Max(1, bar.End.DayNumber - bar.Start.DayNumber + 1);

    private static string BarClass(ActivityStatus status) => status switch
    {
        ActivityStatus.Completed => "bg-success",
        ActivityStatus.InProgress => "bg-primary",
        ActivityStatus.Delayed => "bg-danger",
        ActivityStatus.Scheduled => "bg-info",
        ActivityStatus.Cancelled => "bg-dark",
        _ => "bg-secondary"
    };

    /// <summary>One tick per calendar month across the visible range.</summary>
    private IEnumerable<(string Label, int Offset, int Span)> Ticks()
    {
        if (View is null) yield break;
        var cursor = new DateOnly(View.RangeStart.Year, View.RangeStart.Month, 1);
        while (cursor <= View.RangeEnd)
        {
            var monthEnd = cursor.AddMonths(1).AddDays(-1);
            var visibleStart = cursor < View.RangeStart ? View.RangeStart : cursor;
            var visibleEnd = monthEnd > View.RangeEnd ? View.RangeEnd : monthEnd;
            var span = Math.Max(1, visibleEnd.DayNumber - visibleStart.DayNumber + 1);
            yield return (cursor.ToString("MMM yyyy"), Offset(visibleStart), span);
            cursor = cursor.AddMonths(1);
        }
    }
}
