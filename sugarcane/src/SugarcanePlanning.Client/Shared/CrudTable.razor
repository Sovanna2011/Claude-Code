@typeparam TItem
@typeparam TUpsert where TUpsert : class

@*
    Reusable master-data surface: search, sort-free paging, an inline editor panel and a
    delete confirmation. Every master-data screen supplies its own row and editor markup.
*@
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-semibold">@Title</span>
        <div class="d-flex flex-wrap gap-2">
            <input class="form-control form-control-sm" style="width:220px" placeholder="Search code or name…"
                   value="@query.Search" @onchange="OnSearchChanged" aria-label="Search" />
            <div class="form-check form-switch d-flex align-items-center gap-1">
                <input class="form-check-input" type="checkbox" id="@inactiveId"
                       checked="@query.IncludeInactive" @onchange="OnIncludeInactiveChanged" />
                <label class="form-check-label small" for="@inactiveId">Include inactive</label>
            </div>
            <button class="btn btn-success btn-sm" @onclick="StartCreate">Add new</button>
        </div>
    </div>

    <div class="card-body">
        <ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />
        <SuccessToast Message="@success" OnDismiss="() => success = null" />

        @if (editing is not null)
        {
            <EditForm Model="editing" OnValidSubmit="Save" class="border rounded p-3 mb-3 bg-light">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />
                <div class="row g-2">
                    @EditorTemplate(editing)
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success btn-sm" type="submit" disabled="@busy">
                        @(editingId is null ? "Create" : "Save changes")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelEdit">Cancel</button>
                </div>
            </EditForm>
        }

        @if (busy && Result is null)
        {
            <LoadingPanel />
        }
        else if (Result is null || Result.Items.Count == 0)
        {
            <div class="text-secondary small">No records match the current filter.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            @foreach (var column in Columns)
                            {
                                <th scope="col">@column</th>
                            }
                            <th class="text-end" style="width:130px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Result.Items)
                        {
                            <tr>
                                @RowTemplate(item)
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" @onclick="() => StartEdit(item)">Edit</button>
                                        @if (OnDelete is not null)
                                        {
                                            <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(item)">Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (deleteCandidateId == IdSelector(item))
                            {
                                <tr class="table-warning">
                                    <td colspan="@(Columns.Length + 1)">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span>Delete this record? Records still in use cannot be deleted.</span>
                                            <button class="btn btn-danger btn-sm" @onclick="() => Delete(item)" disabled="@busy">Yes, delete</button>
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => deleteCandidateId = null">Cancel</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <Pager TItem="TItem" Result="Result" OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string[] Columns { get; set; } = Array.Empty<string>();
    [Parameter] public PagedResult<TItem>? Result { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TUpsert> EditorTemplate { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, TUpsert> ToEditModel { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TUpsert> NewModel { get; set; } = default!;
    [Parameter, EditorRequired] public Func<QueryParameters, Task<PagedResult<TItem>>> OnLoad { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TUpsert, Task<TItem?>> OnCreate { get; set; } = default!;
    [Parameter, EditorRequired] public Func<int, TUpsert, Task<TItem?>> OnUpdate { get; set; } = default!;
    [Parameter] public Func<int, Task>? OnDelete { get; set; }
    [Parameter, EditorRequired] public Func<TItem, int> IdSelector { get; set; } = default!;

    private readonly QueryParameters query = new();
    private readonly string inactiveId = $"inactive-{Guid.NewGuid():N}";

    private TUpsert? editing;
    private int? editingId;
    private int? deleteCandidateId;
    private string? error;
    private string? errorCode;
    private string? success;
    private bool busy;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        try
        {
            busy = true;
            error = null;
            Result = await OnLoad(query);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        query.Search = args.Value?.ToString();
        query.Page = 1;
        await Reload();
    }

    private async Task OnIncludeInactiveChanged(ChangeEventArgs args)
    {
        query.IncludeInactive = args.Value is bool value && value;
        query.Page = 1;
        await Reload();
    }

    private async Task GoToPage(int page)
    {
        query.Page = page;
        await Reload();
    }

    private async Task ChangePageSize(int size)
    {
        query.PageSize = size;
        query.Page = 1;
        await Reload();
    }

    private void StartCreate()
    {
        editing = NewModel();
        editingId = null;
        deleteCandidateId = null;
    }

    private void StartEdit(TItem item)
    {
        editing = ToEditModel(item);
        editingId = IdSelector(item);
        deleteCandidateId = null;
    }

    private void CancelEdit()
    {
        editing = null;
        editingId = null;
    }

    private async Task Save()
    {
        if (editing is null) return;
        try
        {
            busy = true;
            error = null;
            if (editingId is null)
            {
                await OnCreate(editing);
                success = "Record created.";
            }
            else
            {
                await OnUpdate(editingId.Value, editing);
                success = "Changes saved.";
            }
            CancelEdit();
            await Reload();
        }
        catch (ApiException ex)
        {
            error = ex.IsConcurrencyConflict
                ? "Another user changed this record while you were editing. Reload and apply your changes again."
                : ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private void ConfirmDelete(TItem item) => deleteCandidateId = IdSelector(item);

    private async Task Delete(TItem item)
    {
        if (OnDelete is null) return;
        try
        {
            busy = true;
            error = null;
            await OnDelete(IdSelector(item));
            success = "Record deleted.";
            deleteCandidateId = null;
            await Reload();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }
}
