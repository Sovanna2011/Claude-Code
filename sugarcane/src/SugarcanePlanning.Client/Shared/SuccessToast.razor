@* Lightweight confirmation banner used after a save. *@
@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-success alert-dismissible d-flex align-items-start gap-2" role="status">
        <div class="flex-grow-1">@Message</div>
        @if (OnDismiss.HasDelegate)
        {
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => OnDismiss.InvokeAsync()"></button>
        }
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
}
