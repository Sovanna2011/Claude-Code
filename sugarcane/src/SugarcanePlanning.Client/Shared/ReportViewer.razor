@inject PlanningApi Api
@inject IJSRuntime Js

@*
    Generic report surface (section 20): renders any ReportResultDto as a sortable, groupable
    grid and offers print preview, PDF and Excel export.
*@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 d-print-none">
    <div>
        <h5 class="mb-0">@(Report?.Title ?? "Report")</h5>
        @if (!string.IsNullOrWhiteSpace(Report?.Subtitle))
        {
            <small class="text-secondary">@Report!.Subtitle</small>
        }
    </div>
    <div class="btn-group">
        <button class="btn btn-outline-secondary btn-sm" @onclick="Print" disabled="@(Report is null)">
            Print preview
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Export(ExportFormat.Pdf)" disabled="@(Report is null || busy)">
            Export PDF
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Export(ExportFormat.Excel)" disabled="@(Report is null || busy)">
            Export Excel
        </button>
    </div>
</div>

<ErrorAlert Message="@error" Code="@errorCode" OnDismiss="() => error = null" />

@if (Report is null)
{
    <LoadingPanel Message="Building the report…" />
}
else if (Report.Rows.Count == 0)
{
    <div class="alert alert-secondary">No data matches the selected filters.</div>
}
else
{
    @if (Report.Filters.Count > 0)
    {
        <div class="small text-secondary mb-2">
            @string.Join(" · ", Report.Filters.Select(f => $"{f.Key}: {f.Value}"))
        </div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    @foreach (var column in Report.Columns)
                    {
                        <th class="@(column.IsNumeric ? "text-end" : "")" scope="col">
                            <button class="btn btn-link btn-sm p-0 text-decoration-none text-reset fw-semibold"
                                    @onclick="() => Sort(column.Key)">
                                @column.Header
                                @if (sortBy == column.Key)
                                {
                                    <span>@(sortDescending ? "▼" : "▲")</span>
                                }
                            </button>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    string? lastGroup = null;
                }
                @foreach (var row in Report.Rows)
                {
                    @if (row.Group is not null && row.Group != lastGroup)
                    {
                        lastGroup = row.Group;
                        <tr class="table-light">
                            <td colspan="@Report.Columns.Count" class="fw-semibold">@row.Group</td>
                        </tr>
                    }
                    <tr class="@(row.IsSubtotal ? "fw-semibold table-light" : "")">
                        @foreach (var column in Report.Columns)
                        {
                            <td class="@(column.IsNumeric ? "text-end" : "")">
                                @if (column.DataType == "status")
                                {
                                    <span class="badge @StatusClass(row.Values.GetValueOrDefault(column.Key))">
                                        @row.Values.GetValueOrDefault(column.Key)
                                    </span>
                                }
                                else
                                {
                                    @row.Values.GetValueOrDefault(column.Key)
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
            @if (Report.Totals.Count > 0)
            {
                <tfoot class="table-light fw-semibold">
                    <tr>
                        @foreach (var column in Report.Columns)
                        {
                            <td class="@(column.IsNumeric ? "text-end" : "")">
                                @if (Report.Totals.TryGetValue(column.Key, out var total))
                                {
                                    @total.ToString("N2")
                                }
                                else if (column.Key == Report.Columns[0].Key)
                                {
                                    <text>Total</text>
                                }
                            </td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <div class="small text-secondary d-print-block">
        Generated @Report.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC by @Report.GeneratedBy
    </div>
}

@code {
    [Parameter, EditorRequired] public ReportKey ReportKey { get; set; }
    [Parameter, EditorRequired] public ReportRequest Request { get; set; } = new();
    [Parameter] public ReportResultDto? Report { get; set; }
    [Parameter] public EventCallback<ReportResultDto?> ReportChanged { get; set; }

    private string? error;
    private string? errorCode;
    private string? sortBy;
    private bool sortDescending;
    private bool busy;

    /// <summary>Reloads the report; call it from the parent after the filters change.</summary>
    public async Task ReloadAsync()
    {
        try
        {
            busy = true;
            error = null;
            Request.SortBy = sortBy;
            Request.SortDescending = sortDescending;
            Report = await Api.GetReportAsync(ReportKey, Request);
            await ReportChanged.InvokeAsync(Report);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
            Report = null;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task Sort(string key)
    {
        if (sortBy == key) sortDescending = !sortDescending;
        else { sortBy = key; sortDescending = false; }
        await ReloadAsync();
    }

    private async Task Print() => await Js.InvokeVoidAsync("window.print");

    private async Task Export(ExportFormat format)
    {
        try
        {
            busy = true;
            error = null;
            var (content, fileName, contentType) = await Api.ExportReportAsync(ReportKey, format, Request);
            await Js.InvokeVoidAsync("sgcDownloadFile", fileName, contentType, Convert.ToBase64String(content));
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            errorCode = ex.Error.Code;
        }
        finally
        {
            busy = false;
        }
    }

    private static string StatusClass(string? status) => status switch
    {
        "Sufficient" or "Completed" or "Approved" => "text-bg-success",
        "AtRisk" or "Revised" => "text-bg-warning",
        "Shortage" or "Delayed" or "Rejected" => "text-bg-danger",
        "InProgress" or "UnderReview" => "text-bg-primary",
        "Scheduled" or "Submitted" => "text-bg-info",
        _ => "text-bg-secondary"
    };
}
