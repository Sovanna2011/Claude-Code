@* Consistent colours for every status enum in the system. *@
<span class="badge @CssClass">@Text</span>

@code {
    [Parameter] public ProjectionStatus? Projection { get; set; }
    [Parameter] public ActivityStatus? Activity { get; set; }
    [Parameter] public CapacityStatus? Capacity { get; set; }
    [Parameter] public AvailabilityStatus? Availability { get; set; }
    [Parameter] public ScheduleStatus? Schedule { get; set; }
    [Parameter] public SeasonStatus? Season { get; set; }
    [Parameter] public ScenarioStatus? Scenario { get; set; }

    private string Text => Projection?.ToString()
        ?? Activity?.ToString() ?? Capacity?.ToString() ?? Availability?.ToString()
        ?? Schedule?.ToString() ?? Season?.ToString() ?? Scenario?.ToString() ?? "—";

    private string CssClass =>
        Projection is not null ? Projection switch
        {
            ProjectionStatus.Draft => "text-bg-secondary",
            ProjectionStatus.Submitted => "text-bg-info",
            ProjectionStatus.UnderReview => "text-bg-primary",
            ProjectionStatus.Approved => "text-bg-success",
            ProjectionStatus.Rejected => "text-bg-danger",
            ProjectionStatus.Revised => "text-bg-warning",
            _ => "text-bg-dark"
        }
        : Activity is not null ? Activity switch
        {
            ActivityStatus.Completed => "text-bg-success",
            ActivityStatus.InProgress => "text-bg-primary",
            ActivityStatus.Delayed => "text-bg-danger",
            ActivityStatus.Cancelled => "text-bg-dark",
            ActivityStatus.Scheduled => "text-bg-info",
            _ => "text-bg-secondary"
        }
        : Capacity is not null ? Capacity switch
        {
            CapacityStatus.Sufficient => "text-bg-success",
            CapacityStatus.AtRisk => "text-bg-warning",
            CapacityStatus.Shortage => "text-bg-danger",
            _ => "text-bg-dark"
        }
        : Availability is not null ? Availability switch
        {
            AvailabilityStatus.Available => "text-bg-success",
            AvailabilityStatus.Assigned => "text-bg-info",
            AvailabilityStatus.UnderMaintenance => "text-bg-warning",
            AvailabilityStatus.Breakdown => "text-bg-danger",
            _ => "text-bg-secondary"
        }
        : Schedule is not null ? Schedule switch
        {
            ScheduleStatus.Completed => "text-bg-success",
            ScheduleStatus.InProgress => "text-bg-primary",
            ScheduleStatus.Confirmed => "text-bg-info",
            ScheduleStatus.Cancelled => "text-bg-dark",
            _ => "text-bg-secondary"
        }
        : Season is not null ? Season switch
        {
            SeasonStatus.Open => "text-bg-success",
            SeasonStatus.Closed => "text-bg-dark",
            _ => "text-bg-secondary"
        }
        : Scenario is not null ? Scenario switch
        {
            ScenarioStatus.Adopted => "text-bg-success",
            ScenarioStatus.Simulated => "text-bg-info",
            ScenarioStatus.Discarded => "text-bg-dark",
            _ => "text-bg-secondary"
        }
        : "text-bg-secondary";
}
