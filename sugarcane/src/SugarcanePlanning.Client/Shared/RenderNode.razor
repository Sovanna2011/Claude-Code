@* Recursive row of the land-structure tree. *@
<div class="d-flex align-items-center gap-2 py-1 border-bottom" style="padding-left:@(Level * 1.25)rem">
    @if (Node.Children.Count > 0)
    {
        <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => expanded = !expanded"
                aria-expanded="@expanded" aria-label="Toggle">
            @(expanded ? "▾" : "▸")
        </button>
    }
    else
    {
        <span style="width:1rem"></span>
    }

    <span class="badge text-bg-light border">@Node.NodeType</span>
    <span class="fw-semibold">@Node.Code</span>
    <span class="text-secondary">@Node.Name</span>

    @if (Node.TotalAreaHa > 0)
    {
        <span class="ms-auto small text-secondary">
            @Node.TotalAreaHa.ToString("N1") ha
            @if (Node.PlantableAreaHa > 0)
            {
                <text> · plantable @Node.PlantableAreaHa.ToString("N1") ha</text>
            }
        </span>
    }
    @if (!Node.IsActive)
    {
        <span class="badge text-bg-secondary">inactive</span>
    }
</div>

@if (expanded)
{
    @foreach (var child in Node.Children)
    {
        <RenderNode Node="child" Level="Level + 1" />
    }
}

@code {
    [Parameter, EditorRequired] public LandStructureNodeDto Node { get; set; } = default!;
    [Parameter] public int Level { get; set; }

    private bool expanded = true;
}
