<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Serves the published Blazor WebAssembly client as static files in the test stack. It is not
    part of the solution and is never deployed with the product: in a real deployment the client
    is plain static output behind IIS, nginx or a CDN, exactly as docs/deployment.md describes.
    It exists because the container images for those web servers live on Docker Hub, which this
    environment cannot reach, whereas the .NET runtime image is available.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SugarcanePlanning.TestSystem.StaticHost</RootNamespace>
  </PropertyGroup>

</Project>
